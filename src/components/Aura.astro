---
import { projects } from '../data/projects';
import { auraProfile } from '../data/aura-profile';
import { assetUrl, publicProjectSlugs } from '../data/urls';

// Only ship published case-study evidence to the browser. Never spread NDA data.
const auraProjects = projects.filter(project => publicProjectSlugs.includes(project.slug));
const auraProjectJson = JSON.stringify(auraProjects).replace(/</g, '\\u003c');
const auraProfileJson = JSON.stringify(auraProfile).replace(/</g, '\\u003c');
---

<aside class="aura" data-aura-state="idle" aria-label="AURA portfolio assistant">
  <button class="aura-orb" type="button" aria-expanded="false" aria-controls="aura-panel" aria-label="Open AURA assistant. You can drag the companion around the screen.">
    <span class="aura-character" aria-hidden="true">
      <img src={assetUrl('/assets/aura-guide.png')} alt="" role="presentation" width="512" height="512" loading="lazy" decoding="async" draggable="false" />
      
    </span>
    <span class="pet-label">AURA</span>
    <span class="pet-hint">DRAG ME OR ASK ME</span>
  </button>

  <section class="aura-panel" id="aura-panel" aria-hidden="true" aria-label="Ask AURA">
    <header class="aura-header">
      <div class="aura-header-copy">
        <span class="aura-kicker"><i></i> Online · portfolio guide</span>
        <b>AURA</b>
      </div>
      <button class="aura-close" type="button" aria-label="Close AURA">&times;</button>
    </header>

    <div class="aura-stage">
      <div class="sigil" aria-hidden="true"><img src={assetUrl('/assets/aura-guide.png')} alt="" role="presentation" width="512" height="512" loading="lazy" decoding="async" draggable="false" /></div>
      <div>
        <p class="kicker">Akshayan's work, with context</p>
        <h2>Ask beyond<br /><em>the résumé.</em></h2>
        <p>Explore projects, decisions, process, experience, and role fit.</p>
      </div>
    </div>

    <div class="aura-log" aria-live="polite">
      <p class="aura-message">Hi, I'm AURA. Ask me about a project, Akshayan's design process, or how his experience fits your team.</p>
    </div>

    <div class="prompts" aria-label="Suggested questions">
      <button type="button">Why hire Akshayan?</button>
      <button type="button">Show me his AI work</button>
      <button type="button">How does he design?</button>
    </div>

    <form class="aura-input">
      <label class="sr-only" for="aura-question">Ask AURA</label>
      <input id="aura-question" autocomplete="off" placeholder="Ask AURA about Akshayan..." />
      <button class="send" type="submit" aria-label="Send question"><span aria-hidden="true">↗</span></button>
      <button class="voice" type="button"><span aria-hidden="true">●</span> <b>Start voice conversation</b></button>
    </form>
    <p class="privacy">Answers are based on the public portfolio. Browser voice is optional.</p>
  </section>
</aside>

<script id="aura-project-knowledge" type="application/json" is:inline set:html={auraProjectJson}></script>
<script id="aura-profile-knowledge" type="application/json" is:inline set:html={auraProfileJson}></script>
<script src="../scripts/aura-intelligent.ts"></script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
  .aura { position: fixed; right: 22px; bottom: 22px; z-index: 9998; font-family: var(--font-sans); }
  .aura-orb {
    width: 215px; height: 58px; display: grid; grid-template-columns: 36px auto 1fr; align-items: center; gap: 10px;
    padding: 8px 13px 8px 9px; color: var(--text); background: rgba(14, 17, 18, .96);
    border: 1px solid rgba(183, 243, 91, .55); border-radius: 14px; box-shadow: 0 12px 35px rgba(0,0,0,.45);
    text-align: left; cursor: pointer; transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
  }
  .aura-orb::after { content: ""; width: 7px; height: 7px; justify-self: end; border-radius: 50%; background: var(--primary); box-shadow: 0 0 12px var(--primary); }
  .aura-orb:hover, .aura-orb:focus-visible { transform: translateY(-3px); border-color: var(--primary); box-shadow: 0 16px 40px rgba(0,0,0,.55), 0 0 20px rgba(183,243,91,.12); }
  .aura-character { position: relative; display: grid; width: 36px; height: 36px; place-items: center; overflow: hidden; border: 1px solid var(--primary); border-radius: 50%; background: #1b2115; }
  .aura-character img { width: 100%; height: 100%; object-fit: cover; }
  .character-status { position: absolute; inset: 0; display: grid; place-items: center; color: var(--primary); font: 800 .84rem/1 var(--font-mono); background: rgba(14,17,18,.12); }
  .pet-label { color: var(--text); font: 800 .72rem/1 var(--font-mono); letter-spacing: .1em; }
  .pet-hint { color: rgba(243,245,244,.48); font: 700 .54rem/1.2 var(--font-mono); letter-spacing: .08em; }

  .aura-panel {
    position: absolute; right: 0; bottom: calc(100% + 16px); width: min(420px, calc(100vw - 28px)); max-height: min(660px, calc(100dvh - 112px));
    display: grid; grid-template-rows: auto auto minmax(112px, 1fr) auto auto auto; overflow: hidden;
    color: var(--text); background: #101214; border: 1px solid rgba(183,243,91,.42); border-radius: 18px;
    box-shadow: 0 24px 70px rgba(0,0,0,.7), 5px 5px 0 rgba(183,243,91,.68);
    opacity: 0; pointer-events: none; transform: translateY(16px) scale(.98); transform-origin: right bottom; transition: opacity .2s ease, transform .22s cubic-bezier(.2,.8,.2,1);
  }
  .aura-panel::after { content: ""; position: absolute; right: 28px; bottom: -10px; width: 18px; height: 18px; background: #101214; border-right: 1px solid rgba(183,243,91,.42); border-bottom: 1px solid rgba(183,243,91,.42); transform: rotate(45deg); }
  .aura.is-open .aura-panel { opacity: 1; pointer-events: auto; transform: none; }
  .aura.is-open .aura-orb { opacity: 0; pointer-events: none; }

  .aura-header { display: flex; align-items: center; justify-content: space-between; padding: 14px 15px 13px; border-bottom: 1px solid rgba(183,243,91,.2); }
  .aura-header-copy { display: grid; gap: 5px; }
  .aura-kicker { display: flex; align-items: center; gap: 7px; color: var(--primary); font: 700 .55rem/1 var(--font-mono); letter-spacing: .13em; }
  .aura-kicker i { width: 6px; height: 6px; border-radius: 50%; background: var(--primary); box-shadow: 0 0 8px var(--primary); }
  .aura-header b { color: var(--text); font: 800 .72rem/1 var(--font-mono); letter-spacing: .1em; }
  .aura-close { display: grid; width: 30px; height: 30px; place-items: center; padding: 0; color: var(--text); background: transparent; border: 1px solid rgba(243,245,244,.26); border-radius: 50%; font: 400 1.45rem/1 var(--font-sans); transition: color .16s ease, background .16s ease; }
  .aura-close:hover, .aura-close:focus-visible { color: var(--on-primary); background: var(--primary); border-color: var(--primary); }

  .aura-stage { display: grid; grid-template-columns: 112px 1fr; align-items: center; gap: 18px; padding: 20px 18px; border-bottom: 1px solid rgba(183,243,91,.12); background: linear-gradient(115deg, rgba(183,243,91,.09), transparent 57%); }
  .sigil { display: grid; width: 112px; height: 116px; place-items: end center; overflow: hidden; background: linear-gradient(135deg, rgba(183,243,91,.08), transparent 70%); }
  .sigil img { width: 100%; height: 100%; object-fit: contain; object-position: center bottom; background: transparent; }
  [data-aura-state=listening] .sigil, [data-aura-state=speaking] .sigil { animation: aura-pulse 1.1s ease-in-out infinite; }
  .kicker { margin: 0 0 7px; color: var(--primary); font: 700 .55rem/1 var(--font-mono); letter-spacing: .14em; }
  .aura-stage h2 { margin: 0; color: var(--text); font: 800 1.72rem/.91 var(--font-display); letter-spacing: .01em; text-transform: uppercase; }
  .aura-stage h2 em { color: var(--primary); font-style: normal; }
  .aura-stage p:last-child { margin: 9px 0 0; color: rgba(243,245,244,.58); font-size: .72rem; line-height: 1.5; }

  .aura-log { min-height: 0; padding: 14px 16px 8px; overflow-y: auto; background: #0c0e0f; }
  .aura-message { margin: 0 0 10px; padding: 10px 11px; color: rgba(243,245,244,.84); background: rgba(255,255,255,.035); border-left: 2px solid var(--primary); font: 600 .76rem/1.55 var(--font-sans); }
  .aura-message::before { content: "AURA / "; color: var(--primary); font: 800 .61rem/1 var(--font-mono); letter-spacing: .08em; }
  .aura-message.user { margin-left: 34px; border-left: 0; border-right: 2px solid var(--primary); text-align: right; }
  .aura-message.user::before { content: "YOU / "; }

  .prompts { display: flex; gap: 6px; padding: 10px 16px; overflow-x: auto; border-top: 1px solid rgba(183,243,91,.1); }
  .prompts button { flex: 0 0 auto; padding: 7px 9px; color: rgba(243,245,244,.65); background: transparent; border: 1px solid rgba(243,245,244,.16); border-radius: 999px; font: 700 .57rem/1 var(--font-mono); letter-spacing: .03em; transition: color .16s ease, border-color .16s ease, background .16s ease; }
  .prompts button:hover, .prompts button:focus-visible { color: var(--on-primary); background: var(--primary); border-color: var(--primary); }

  .aura-input { display: grid; grid-template-columns: 1fr 40px; gap: 7px; padding: 4px 16px 0; }
  .aura-input input { min-width: 0; height: 40px; padding: 0 11px; color: var(--text); background: #16191a; border: 1px solid rgba(243,245,244,.22); border-radius: 9px; font: 600 .73rem/1 var(--font-sans); outline: none; }
  .aura-input input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(183,243,91,.1); }
  .send { display: grid; place-items: center; color: var(--on-primary); background: var(--primary); border: 1px solid var(--primary); border-radius: 9px; font: 800 .55rem/1 var(--font-mono); letter-spacing: .04em; }
  .send:hover, .send:focus-visible { filter: brightness(.92); }
  .voice { grid-column: 1 / -1; height: 34px; margin: 1px 0 0; color: var(--primary); background: transparent; border: 1px solid rgba(183,243,91,.32); border-radius: 9px; font: 700 .61rem/1 var(--font-mono); letter-spacing: .12em; }
  .voice:hover, .voice:focus-visible { color: var(--on-primary); background: rgba(183,243,91,.13); border-color: var(--primary); }
  .voice span { font-size: .48rem; vertical-align: 1px; }
  .privacy { margin: 0; padding: 9px 16px 14px; color: rgba(243,245,244,.36); font: 600 .54rem/1.35 var(--font-mono); letter-spacing: .02em; }
  .aura-status { color: var(--primary); font: 700 .62rem/1.35 var(--font-mono); }
  .aura-status.error { color: #ff8276; }
  @keyframes aura-pulse { 50% { box-shadow: 0 0 0 8px rgba(183,243,91,.08), 0 0 24px rgba(183,243,91,.25); } }

  @media (max-width: 560px) {
    .aura { right: 14px; bottom: 14px; }
    .aura-orb { width: 58px; grid-template-columns: 36px; padding: 9px; border-radius: 50%; }
    .aura-orb::after, .pet-label, .pet-hint { display: none; }
    .aura-panel { position: fixed; right: 12px; bottom: 12px; width: calc(100vw - 24px); max-height: calc(100dvh - 24px); transform-origin: right bottom; }
    .aura-panel::after { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .aura-orb, .aura-panel { transition: none; } [data-aura-state=listening] .sigil, [data-aura-state=speaking] .sigil { animation: none; } }

  /* AURA companion mode: movable pet first, assistant second. */
  .aura { right: 26px; bottom: 24px; }
  .aura-orb {
    position: relative; width: 84px; height: 100px; display: block; padding: 0; overflow: visible;
    color: var(--text); background: transparent; border: 0; border-radius: 0; box-shadow: none; touch-action: none; user-select: none;
    cursor: grab; transition: transform .18s ease, opacity .18s ease;
  }
  .aura-orb:active { cursor: grabbing; }
  .aura-orb::after { display: none; }
  .aura-orb:hover, .aura-orb:focus-visible { transform: translateY(-4px); border: 0; box-shadow: none; }
  .aura-character {
    position: absolute; top: 3px; left: 7px; width: 70px; height: 70px; overflow: visible;
    border: 1px solid rgba(183,243,91,.78); background: #111516; box-shadow: 0 0 0 7px rgba(183,243,91,.08), 0 0 22px rgba(183,243,91,.24);
  }
  .aura-character::before, .aura-character::after { content: ""; position: absolute; inset: -9px; border: 1px dashed rgba(183,243,91,.3); border-radius: 50%; pointer-events: none; }
  .aura-character::after { inset: -15px; border-color: rgba(183,243,91,.12); animation: aura-orbit 7s linear infinite; }
  .aura-character img { border-radius: 50%; }
  .character-status { color: var(--primary); background: rgba(14,17,18,.16); font-size: 1.35rem; }
  .pet-label {
    position: absolute; bottom: 0; left: 0; width: 84px; color: var(--primary); font: 800 .62rem/1 var(--font-mono); letter-spacing: .12em; text-align: center;
  }
  .pet-hint {
    position: absolute; top: 15px; right: calc(100% + 14px); width: max-content; max-width: 175px; padding: 8px 10px;
    color: var(--text); background: #101214; border: 1px solid rgba(183,243,91,.42); border-radius: 8px; box-shadow: 3px 3px 0 rgba(183,243,91,.5);
    font: 700 .54rem/1.25 var(--font-mono); letter-spacing: .07em; opacity: 0; transform: translateX(5px); pointer-events: none; transition: opacity .18s ease, transform .18s ease;
  }
  .pet-hint::after { content: ""; position: absolute; right: -5px; top: 16px; width: 8px; height: 8px; background: #101214; border-top: 1px solid rgba(183,243,91,.42); border-right: 1px solid rgba(183,243,91,.42); transform: rotate(45deg); }
  .aura-orb:hover .pet-hint, .aura-orb:focus-visible .pet-hint, .aura[data-pet-mode="play"] .pet-hint { opacity: 1; transform: none; }
  .aura[data-pet-mode="play"] .aura-character { animation: aura-pet-bounce .55s ease-in-out 2; }
  .aura[data-pet-mode="play"] .character-status { color: #101214; background: var(--primary); }
  .aura[data-pet-mode="play"] .pet-hint { color: #101214; background: var(--primary); }
  .aura[data-pet-mode="play"] .pet-hint::after { background: var(--primary); }
  .aura.is-open .aura-panel { position: fixed; right: 26px; bottom: 132px; }
  @keyframes aura-orbit { to { transform: rotate(360deg); } }
  @keyframes aura-pet-bounce { 50% { transform: translateY(-10px) rotate(8deg); } }
  @media (max-width: 560px) {
    .aura { right: 14px; bottom: 14px; }
    .aura-orb { width: 76px; height: 88px; }
    .aura-character { width: 62px; height: 62px; }
    .pet-label { width: 76px; }
    .aura.is-open .aura-panel { right: 12px; bottom: 12px; }
    .pet-hint { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .aura-character::after, .aura[data-pet-mode="play"] .aura-character { animation: none; }
  }

  /* Character dock: the companion is the interface, not an avatar badge. */
  .aura-orb {
    width: 220px; height: 148px; display: block; overflow: visible; background: transparent; border: 0; box-shadow: none;
  }
  .aura-orb:hover, .aura-orb:focus-visible { transform: translateY(-4px); box-shadow: none; }
  .aura-character {
    inset: auto auto 0 0; width: 148px; height: 148px; display: block; overflow: visible; border: 0; border-radius: 0; background: transparent; box-shadow: none;
  }
  .aura-character::before, .aura-character::after { display: none; }
  .aura-character img { width: 100%; height: 100%; object-fit: contain; object-position: left bottom; border-radius: 0; }
  .pet-label {
    left: 116px; bottom: 35px; z-index: 2; width: 104px; padding: 12px 10px 11px; color: #101214; background: var(--primary);
    border-radius: 2px; box-shadow: 4px 4px 0 rgba(0,0,0,.56); font: 900 .68rem/1 var(--font-mono); letter-spacing: .12em; text-align: center;
  }
  .pet-label::before { content: ""; position: absolute; left: -10px; top: 12px; width: 0; height: 0; border-top: 8px solid transparent; border-bottom: 8px solid transparent; border-right: 10px solid var(--primary); }
  .pet-hint { top: auto; right: 0; bottom: 8px; padding: 6px 8px; font-size: .49rem; }
  .pet-hint::after { display: none; }
  .aura[data-pet-mode="play"] .pet-label { background: #fff; }
  @media (max-width: 560px) {
    .aura-orb { width: 154px; height: 112px; }
    .aura-character { width: 112px; height: 112px; }
    .pet-label { left: 86px; bottom: 28px; width: 68px; padding: 9px 5px; font-size: .52rem; }
  }

  /* Conversation-first AURA redesign. */
  .aura {
    --aura-bg: #0d1010;
    --aura-surface: #141817;
    --aura-surface-raised: #1a1f1d;
    --aura-line: rgba(218, 239, 202, .12);
    --aura-line-strong: rgba(183, 243, 91, .34);
    --aura-muted: rgba(231, 237, 228, .58);
    --aura-shadow: rgba(3, 8, 5, .72);
  }
  .aura-panel {
    width: min(470px, calc(100vw - 32px));
    max-height: min(720px, calc(100dvh - 156px));
    grid-template-rows: auto auto minmax(88px, 1fr) auto auto auto;
    background:
      radial-gradient(circle at 12% 0%, rgba(183,243,91,.08), transparent 28%),
      var(--aura-bg);
    border: 1px solid var(--aura-line-strong);
    border-radius: 24px;
    box-shadow: 0 30px 90px var(--aura-shadow), 0 0 0 1px rgba(255,255,255,.025) inset;
  }
  .aura-panel::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; border-radius: inherit;
    background-image: radial-gradient(rgba(255,255,255,.05) .55px, transparent .55px);
    background-size: 5px 5px; opacity: .14;
  }
  .aura-panel::after { display: none; }
  .aura-header { min-height: 72px; padding: 16px 20px; border-bottom: 1px solid var(--aura-line); background: rgba(13,16,16,.72); backdrop-filter: blur(18px); }
  .aura-header-copy { grid-template-columns: auto 1fr; grid-template-rows: auto auto; column-gap: 11px; }
  .aura-header-copy::before {
    content: "A"; grid-row: 1 / 3; display: grid; width: 36px; height: 36px; place-items: center;
    color: #11150f; background: var(--primary); border-radius: 11px; font: 900 1rem/1 var(--font-display);
    box-shadow: 0 0 24px rgba(183,243,91,.18);
  }
  .aura-kicker { color: var(--aura-muted); font: 500 .62rem/1.2 var(--font-sans); letter-spacing: 0; text-transform: none; }
  .aura-kicker i { width: 7px; height: 7px; }
  .aura-header b { font: 700 .9rem/1 var(--font-sans); letter-spacing: .04em; }
  .aura-close { width: 38px; height: 38px; color: var(--aura-muted); border-color: var(--aura-line); border-radius: 12px; font-size: 1.35rem; cursor: pointer; }
  .aura-close:hover, .aura-close:focus-visible { color: #10140e; transform: rotate(3deg); }

  .aura-stage { grid-template-columns: 92px 1fr; gap: 20px; padding: 22px 22px 24px; border-bottom: 1px solid var(--aura-line); background: transparent; }
  .sigil { width: 92px; height: 108px; border-radius: 16px 16px 6px 6px; background: linear-gradient(155deg, rgba(183,243,91,.1), rgba(183,243,91,.015)); box-shadow: 0 0 0 1px rgba(183,243,91,.08) inset; }
  .kicker { margin-bottom: 8px; color: var(--aura-muted); font: 600 .65rem/1.2 var(--font-sans); letter-spacing: 0; text-transform: none; }
  .aura-stage h2 { font-size: clamp(2rem, 5vw, 2.65rem); line-height: .86; letter-spacing: -.015em; text-wrap: balance; }
  .aura-stage h2 em { color: var(--primary); }
  .aura-stage p:last-child { max-width: 30ch; margin-top: 12px; color: var(--aura-muted); font-size: .78rem; line-height: 1.55; text-wrap: pretty; }

  .aura-log { padding: 20px; background: rgba(7,10,9,.5); scrollbar-color: rgba(183,243,91,.32) transparent; }
  .aura-message { position: relative; width: fit-content; max-width: 92%; margin: 0 0 14px; padding: 13px 15px; color: rgba(243,245,244,.9); background: var(--aura-surface-raised); border: 1px solid var(--aura-line); border-left: 0; border-radius: 4px 16px 16px 16px; font: 500 .82rem/1.6 var(--font-sans); box-shadow: 0 8px 24px rgba(0,0,0,.14); text-wrap: pretty; }
  .aura-message::before { content: "AURA"; display: block; margin-bottom: 5px; color: var(--primary); font: 700 .57rem/1 var(--font-sans); letter-spacing: .08em; }
  .aura-message.user { width: fit-content; margin-left: auto; padding: 12px 14px; color: #14190f; background: var(--primary); border: 0; border-radius: 16px 4px 16px 16px; text-align: left; }
  .aura-message.user::before { content: "YOU"; color: rgba(20,25,15,.62); }

  .prompts { gap: 8px; padding: 12px 20px 10px; border-top: 1px solid var(--aura-line); scrollbar-width: none; }
  .prompts::-webkit-scrollbar { display: none; }
  .prompts button { padding: 9px 12px; color: rgba(243,245,244,.72); background: var(--aura-surface); border-color: var(--aura-line); border-radius: 10px; font: 600 .68rem/1 var(--font-sans); letter-spacing: 0; cursor: pointer; }
  .prompts button:hover, .prompts button:focus-visible { color: var(--text); background: rgba(183,243,91,.1); border-color: var(--aura-line-strong); transform: translateY(-1px); }
  .prompts button:active, .send:active, .voice:active { transform: scale(.98); }

  .aura-input { grid-template-columns: 1fr 48px; gap: 8px; padding: 4px 20px 0; }
  .aura-input input { height: 50px; padding: 0 15px; color: var(--text); background: var(--aura-surface); border-color: var(--aura-line); border-radius: 14px; font: 500 .82rem/1 var(--font-sans); }
  .aura-input input::placeholder { color: rgba(231,237,228,.36); }
  .aura-input input:hover { border-color: rgba(243,245,244,.2); }
  .aura-input input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(183,243,91,.11); }
  .send { width: 48px; height: 50px; border-radius: 14px; font: 700 1.3rem/1 var(--font-sans); cursor: pointer; transition: transform .16s ease, filter .16s ease; }
  .send:hover, .send:focus-visible { filter: brightness(1.08); transform: translateY(-1px); }
  .voice { height: 40px; color: rgba(243,245,244,.7); background: transparent; border-color: var(--aura-line); border-radius: 12px; font: 600 .7rem/1 var(--font-sans); letter-spacing: 0; text-transform: none; cursor: pointer; }
  .voice span { margin-right: 7px; color: var(--primary); font-size: .52rem; vertical-align: 1px; }
  .voice:hover, .voice:focus-visible { color: var(--text); background: rgba(183,243,91,.07); border-color: var(--aura-line-strong); }
  .privacy { padding: 10px 20px 18px; color: rgba(231,237,228,.38); font: 500 .6rem/1.4 var(--font-sans); letter-spacing: 0; text-align: center; }
  .aura-status { font-family: var(--font-sans); }

  .aura-orb:focus-visible, .aura-close:focus-visible, .prompts button:focus-visible, .send:focus-visible, .voice:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  @media (min-width: 561px) {
    .aura.is-open .aura-panel {
      top: max(12px, env(safe-area-inset-top));
      bottom: 132px;
      height: auto;

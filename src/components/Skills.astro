---
// Arsenal - Bordered spec-panel grid
const design = [
  "Figma", "UX Architecture", "AI UX Design",
  "Design Systems", "User Research", "Interaction Design",
  "Wireframing", "Prototyping",
];
const product = [
  "Jira", "Asana", "Linear", "Notion",
  "Confluence", "Miro", "FigJam", "Slack",
];
const dev = [
  "Flutter", "React.js", "Node.js", "TypeScript",
  "Astro", "Tailwind CSS", "MySQL", "Git",
];
---

<section class="skills chapter-section" id="skills">
  <div class="container">

    <p class="section-eyebrow" data-reveal>Arsenal</p>
    <h2 class="section-title" data-reveal="clip" style="--reveal-delay: 80ms">Tools I<br/><em>think with.</em></h2>

    <div class="skills-grid">
      <div class="sk-col" data-reveal style="--reveal-delay: 160ms">
        <div class="sk-col-header">
          <span class="sk-col-idx">01</span>
          <h3 class="sk-col-head">Design &amp; Product</h3>
        </div>
        <ul class="sk-list">
          {design.map(s => <li>{s}</li>)}
        </ul>
      </div>
      <div class="sk-col" data-reveal style="--reveal-delay: 240ms">
        <div class="sk-col-header">
          <span class="sk-col-idx">02</span>
          <h3 class="sk-col-head">Project Management</h3>
        </div>
        <ul class="sk-list">
          {product.map(s => <li>{s}</li>)}
        </ul>
      </div>
      <div class="sk-col" data-reveal style="--reveal-delay: 320ms">
        <div class="sk-col-header">
          <span class="sk-col-idx">03</span>
          <h3 class="sk-col-head">Development</h3>
        </div>
        <ul class="sk-list">
          {dev.map(s => <li>{s}</li>)}
        </ul>
        <p class="sk-note">
          Technical depth lets me design systems that are
          implementation-aware, not concept-driven.
        </p>
      </div>
    </div>

    <div class="sk-footer" data-reveal style="--reveal-delay: 420ms">
      <span class="sk-footer-idx">// DIRECTION</span>
      <p class="sk-direction">
        The next generation of designers won't just design UI -
        <span>they'll design intelligence.</span>
      </p>
    </div>

  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(204, 255, 0, 0.15);
    border-left: 1px solid rgba(204, 255, 0, 0.15);
    margin-bottom: 0;
  }

  .sk-col {
    padding: 28px 24px 24px;
    border-right: 1px solid rgba(204, 255, 0, 0.15);
    border-bottom: 1px solid rgba(204, 255, 0, 0.15);
    position: relative;
  }

  .sk-col-header {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(204, 255, 0, 0.08);
    margin-bottom: 4px;
  }

  .sk-col-idx {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(204, 255, 0, 0.35);
  }

  .sk-col-head {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(242, 237, 227, 0.3);
  }

  .sk-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: 16px;
  }

  .sk-list li {
    font-size: 13px;
    color: rgba(242, 237, 227, 0.55);
    padding: 10px 0;
    border-bottom: 1px solid rgba(204, 255, 0, 0.06);
    transition: color 0s steps(1), padding-left 0s steps(1);
    cursor: default;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sk-list li::before {
    content: '';
    width: 3px;
    height: 3px;
    background: rgba(204, 255, 0, 0.2);
    flex-shrink: 0;
    transition: background 0s steps(1);
  }

  .sk-list li:hover {
    color: var(--text);
    padding-left: 4px;
  }

  .sk-list li:hover::before {
    background: var(--primary);
  }

  .sk-note {
    font-size: 11px;
    color: rgba(242, 237, 227, 0.25);
    line-height: 1.6;
  }

  /* Footer direction bar */
  .sk-footer {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 28px 24px;
    border-left: 1px solid rgba(204, 255, 0, 0.15);
    border-right: 1px solid rgba(204, 255, 0, 0.15);
    border-bottom: 1px solid rgba(204, 255, 0, 0.15);
  }

  .sk-footer-idx {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2px;
    color: rgba(204, 255, 0, 0.3);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .sk-direction {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 2.4rem);
    font-weight: 400;
    color: rgba(242, 237, 227, 0.25);
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sk-direction span {
    color: var(--text);
  }

  @media (max-width: 768px) {
    .skills-grid { grid-template-columns: 1fr 1fr; }
    .sk-col:nth-child(3) { grid-column: 1 / -1; }
    .sk-footer { flex-direction: column; gap: 12px; }
  }

  @media (max-width: 480px) {
    .skills-grid { grid-template-columns: 1fr; }
    .sk-col:nth-child(3) { grid-column: auto; }
    .sk-col { padding: 20px 16px; }
  }
</style>

---
const jobs = [
  {
    num: '01', company: 'Mondee', period: '2026 - Present', role: 'UX Designer & Content Strategist',
    product: 'Miraee / AI-native enterprise product', theme: 'Designing intelligence', accent: '#B7F35B', current: true,
    input: 'AI behavior, enterprise roles, and ambiguous decisions',
    move: 'Orchestrate product language, interface behavior, and content into one system',
    outcome: 'A clearer product that guides people through high-stakes decisions',
    note: 'Building the experience and content strategy for an AI-native enterprise product from the ground up.',
    tags: ['AI-native UX', 'Content systems', 'Enterprise workflows'],
  },
  {
    num: '02', company: 'Kodecopter', period: '2024 - 2025', role: 'Product Designer',
    product: 'AI systems and full-stack products', theme: 'Making complexity operable', accent: '#6D7CFF',
    input: 'Dense product logic, technical constraints, and fast-moving product scope',
    move: 'Turn complex architecture into flows, dashboards, and implementation-ready systems',
    outcome: 'Four products shipped with end-to-end design ownership',
    note: 'Designed AI tooling, financial dashboards, and documentation-first product experiences in a fast-moving startup.',
    tags: ['0 to 1', 'Design systems', 'Product architecture'],
  },
  {
    num: '03', company: 'Bloom Majestic', period: '2022 - 2023', role: 'UI/UX Designer',
    product: 'Inniyal / mental wellness product', theme: 'Designing with sensitivity', accent: '#E0A5FF',
    input: 'Emotionally sensitive moments and users with limited cognitive bandwidth',
    move: 'Use calm interaction patterns, intentional pacing, and accessible guidance',
    outcome: 'A more supportive daily-use experience with less friction',
    note: 'Crafted mobile experiences where clarity and emotional safety mattered as much as visual polish.',
    tags: ['Mobile UX', 'Emotional design', 'User flows'],
  },
  {
    num: '04', company: 'Aakam 360', period: '2023 - 2024', role: 'UI/UX Intern',
    product: 'PregTrack / MSME-approved health product', theme: 'Building trust in health', accent: '#8FD7E8',
    input: 'Health decisions, compliance needs, and anxious first-time users',
    move: 'Structure clear user flows and support implementation with product context',
    outcome: 'A government-approved product brought from concept to launch',
    note: 'Supported end-to-end flows and frontend implementation for a pregnancy-tracking experience.',
    tags: ['Health tech', 'Frontend support', 'Trust patterns'],
  },
];
---

<section class="experience chapter-section" id="experience">
  <div class="container">
    <header class="experience-intro" data-reveal>
      <p class="section-eyebrow">Experience</p>
      <p class="experience-kicker">A career is not a list of roles. It is a collection of systems learned, tested, and made clearer.</p>
      <h2 class="experience-title">Systems I've<br /><em>learned to design.</em></h2>
    </header>

    <div class="dossier-list">
      {jobs.map((job) => (
        <article class:list={['dossier', { 'dossier--current': job.current }]} style={`--dossier-accent: ${job.accent}`} data-reveal>
          <div class="dossier-rail" aria-hidden="true">
            <span class="rail-index">{job.num}</span>
            <span class="rail-line"></span>
            {job.current && <span class="rail-status">Now</span>}
          </div>

          <div class="dossier-content">
            <header class="dossier-header">
              <div>
                <p class="dossier-company">{job.company}</p>
                <p class="dossier-role">{job.role}</p>
              </div>
              <p class="dossier-period">{job.period}</p>
            </header>

            <div class="dossier-statement">
              <p class="dossier-product">{job.product}</p>
              <h3>{job.theme}</h3>
            </div>

            <div class="system-map" aria-label={`How Akshayan approached ${job.company}`}>
              <div class="system-cell">
                <span>System input</span>
                <p>{job.input}</p>
              </div>
              <div class="system-connector" aria-hidden="true"><i></i><b>-></b></div>
              <div class="system-cell">
                <span>Design move</span>
                <p>{job.move}</p>
              </div>
              <div class="system-connector" aria-hidden="true"><i></i><b>-></b></div>
              <div class="system-cell system-cell--outcome">
                <span>Result</span>
                <p>{job.outcome}</p>
              </div>
            </div>

            <footer class="dossier-footer">
              <p>{job.note}</p>
              <ul aria-label="Focus areas">{job.tags.map((tag) => <li>{tag}</li>)}</ul>
            </footer>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-intro { max-width: 960px; margin-bottom: 64px; }
  .experience-kicker { max-width: 550px; margin: 0 0 22px; color: rgba(243,245,244,.58); font-size: 15px; line-height: 1.7; }
  .experience-title { font-family: var(--font-display); font-size: clamp(4rem, 10vw, 10rem); font-weight: 400; letter-spacing: .02em; line-height: .84; text-transform: uppercase; }
  .experience-title em { color: var(--primary); font-style: normal; }

  .dossier-list { display: grid; gap: 16px; }
  .dossier { display: grid; grid-template-columns: 92px minmax(0, 1fr); border: 1px solid rgba(243,245,244,.13); background: rgba(23,26,29,.68); transition: border-color .25s ease, background .25s ease, transform .25s ease; }
  .dossier:hover { border-color: color-mix(in srgb, var(--dossier-accent) 60%, transparent); background: var(--white); transform: translateX(6px); }
  .dossier--current { border-color: color-mix(in srgb, var(--dossier-accent) 56%, transparent); background: linear-gradient(105deg, color-mix(in srgb, var(--dossier-accent) 11%, var(--white)), var(--white) 54%); }

  .dossier-rail { display: flex; flex-direction: column; align-items: center; padding: 28px 0 0; border-right: 1px solid rgba(243,245,244,.1); font-family: var(--font-mono); text-transform: uppercase; }
  .rail-index { color: var(--dossier-accent); font-size: 11px; font-weight: 700; letter-spacing: 2px; }
  .rail-line { flex: 1; width: 1px; min-height: 54px; margin: 14px 0; background: linear-gradient(var(--dossier-accent), transparent); opacity: .7; }
  .rail-status { margin-bottom: 22px; color: var(--dossier-accent); font-size: 9px; letter-spacing: 1.5px; writing-mode: vertical-rl; }

  .dossier-content { padding: 28px 32px 26px; }
  .dossier-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: clamp(36px, 6vw, 68px); }
  .dossier-company { color: var(--text); font-size: clamp(1.45rem, 2.3vw, 2rem); font-weight: 600; line-height: 1.05; }
  .dossier-role, .dossier-period, .dossier-product { font-family: var(--font-mono); font-size: 10px; letter-spacing: 1.4px; text-transform: uppercase; }
  .dossier-role { color: rgba(243,245,244,.48); margin-top: 7px; }
  .dossier-period { color: rgba(243,245,244,.52); white-space: nowrap; }
  .dossier-product { color: var(--dossier-accent); margin-bottom: 13px; }
  .dossier-statement h3 { max-width: 850px; color: var(--text); font-family: var(--font-display); font-size: clamp(2.7rem, 6vw, 6.3rem); font-weight: 400; letter-spacing: .025em; line-height: .88; text-transform: uppercase; }

  .system-map { display: grid; grid-template-columns: 1fr 34px 1.25fr 34px 1fr; gap: 12px; align-items: stretch; margin: 42px 0 30px; padding: 20px 0; border-top: 1px solid rgba(243,245,244,.11); border-bottom: 1px solid rgba(243,245,244,.11); }
  .system-cell span { display: block; margin-bottom: 10px; color: rgba(243,245,244,.42); font-family: var(--font-mono); font-size: 9px; letter-spacing: 1.5px; text-transform: uppercase; }
  .system-cell p { color: rgba(243,245,244,.72); font-size: 14px; line-height: 1.55; }
  .system-cell--outcome p { color: var(--text); }
  .system-connector { display: flex; align-items: center; justify-content: center; position: relative; }
  .system-connector i { position: absolute; width: 100%; height: 1px; background: var(--dossier-accent); opacity: .55; }
  .system-connector b { position: relative; z-index: 1; padding: 0 3px; color: var(--dossier-accent); background: var(--white); font-family: var(--font-mono); font-size: 11px; font-weight: 400; }
  .dossier--current .system-connector b { background: #1b201b; }

  .dossier-footer { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; align-items: end; }
  .dossier-footer > p { max-width: 670px; color: rgba(243,245,244,.52); font-size: 14px; line-height: 1.65; }
  .dossier-footer ul { display: flex; flex-wrap: wrap; justify-content: end; gap: 7px; list-style: none; }
  .dossier-footer li { padding: 5px 8px; border: 1px solid color-mix(in srgb, var(--dossier-accent) 32%, transparent); color: var(--dossier-accent); font-family: var(--font-mono); font-size: 9px; letter-spacing: .8px; }

  @media (max-width: 760px) {
    .experience-intro { margin-bottom: 42px; }
    .dossier { grid-template-columns: 48px minmax(0, 1fr); }
    .dossier-rail { padding-top: 22px; }
    .dossier-content { padding: 24px 18px; }
    .dossier-header { margin-bottom: 36px; }
    .dossier-period { font-size: 9px; }
    .system-map { grid-template-columns: 1fr; gap: 14px; margin: 28px 0 24px; }
    .system-connector { height: 24px; justify-content: flex-start; }
    .system-connector i { width: 32px; }
    .system-connector b { margin-left: 24px; }
    .dossier-footer { grid-template-columns: 1fr; }
    .dossier-footer ul { justify-content: flex-start; }
  }
  /* A single soft radius makes each career dossier feel like a considered surface. */
  .dossier { border-radius: 16px; overflow: hidden; }
  .dossier-footer li { border-radius: 999px; }

</style>
---
// Contact
---

<section class="contact chapter-section" id="contact">
  <div class="container">

    <p class="section-eyebrow" data-reveal>Get in touch</p>

    <div class="contact-layout">
      <div class="contact-left">
        <h2 class="contact-heading" data-reveal="clip">
          Let's build<br/>
          <em>something.</em>
        </h2>
        <p class="contact-sub" data-reveal style="--reveal-delay: 120ms">
          Open to full-time roles, consulting, and conversations
          about AI-native product design.
        </p>

        <div class="contact-links" data-reveal style="--reveal-delay: 240ms">
          <a href="mailto:akshayanmohandass@gmail.com" class="cl-item">
            <span class="cl-label">Email</span>
            <span class="cl-val">akshayanmohandass@gmail.com -></span>
          </a>
          <a href="https://www.linkedin.com/in/akshayan-mohandass-" target="_blank" rel="noopener noreferrer" class="cl-item">
            <span class="cl-label">LinkedIn</span>
            <span class="cl-val">akshayan-mohandass -></span>
          </a>
          <a href="https://drive.google.com/uc?export=download&id=1JxVQMcN5wL2YpTLA3L74jXCL82JdWJon" target="_blank" rel="noopener noreferrer" class="cl-item">
            <span class="cl-label">Resume</span>
            <span class="cl-val">Download PDF -></span>
          </a>
        </div>
      </div>

      <div class="contact-right" data-reveal style="--reveal-delay: 200ms">
        <div class="cf-frame" aria-hidden="true">
          <span class="cf-corner cf-tl"></span>
          <span class="cf-corner cf-tr"></span>
          <span class="cf-corner cf-bl"></span>
          <span class="cf-corner cf-br"></span>
        </div>
        <form class="contact-form" id="contact-form">`n          <div class="cf-honeypot" aria-hidden="true">`n            <label for="c-website">Website</label>`n            <input type="text" id="c-website" name="website" tabindex="-1" autocomplete="off" />`n          </div>
          <p class="cf-title"><span>Project brief</span> Share a little context</p>
          <div class="cf-group">
            <label for="c-name">Name</label>
            <input type="text" id="c-name" name="name" placeholder="Your name" maxlength="100" required />
          </div>
          <div class="cf-group">
            <label for="c-email">Email</label>
            <input type="email" id="c-email" name="email" placeholder="your@email.com" maxlength="254" required />
          </div>
          <div class="cf-group">
            <label for="c-msg">Message</label>
            <textarea id="c-msg" name="message" rows="5" placeholder="What are you building?" maxlength="2000" required></textarea>
          </div>
          <button type="submit" class="cf-submit" id="cf-btn">Send message -></button>
          <p class="cf-feedback" id="cf-feedback" aria-live="polite"></p>
        </form>
      </div>
    </div>

  </div>
</section>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(56px, 7vw, 112px);
    align-items: start;
  }

  .contact-heading {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw, 9rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: 0.04em;
    color: var(--text);
    text-transform: uppercase;
    margin-bottom: 32px;
  }

  .contact-heading em {
    color: var(--primary);
    font-style: normal;
    display: block;
  }

  .contact-sub {
    font-size: clamp(0.95rem, 1.2vw, 1rem);
    color: rgba(242, 237, 227, 0.5);
    line-height: 1.85;
    margin-bottom: 40px;
    max-width: 360px;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .cl-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(204, 255, 0, 0.08);
    transition: all 0s steps(1);
  }

  .cl-item:first-child { border-top: 1px solid rgba(204, 255, 0, 0.08); }
  .cl-item:hover { padding-left: 4px; background: rgba(204, 255, 0, 0.03); }
  .cl-item:hover .cl-val { color: var(--primary); }

  .cl-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(242, 237, 227, 0.25);
  }

  .cl-val {
    font-size: 13px;
    color: rgba(242, 237, 227, 0.55);
    transition: color 0.2s ease;
  }

  /* '' Frame overlay '' */
  .contact-right {
    position: relative;
    min-width: 0;
  }

  .cf-frame {
    position: absolute;
    inset: -14px;
    pointer-events: none;
    z-index: 2;
  }

  .cf-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: rgba(204, 255, 0, 0.25);
    border-style: solid;
  }

  .cf-tl { top: 0;  left: 0;  border-width: 1px 0 0 1px; }
  .cf-tr { top: 0;  right: 0; border-width: 1px 1px 0 0; }
  .cf-bl { bottom: 0; left: 0;  border-width: 0 0 1px 1px; }
  .cf-br { bottom: 0; right: 0; border-width: 0 1px 1px 0; }

  .cf-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 2px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(183, 243, 91, 0.22);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1.4px;
    color: rgba(243, 245, 244, 0.62);
    text-transform: uppercase;
  }

  .cf-title span { color: var(--primary); }

  /* '' Form '' */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .cf-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cf-group label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(242, 237, 227, 0.3);
  }

  .cf-group input,
  .cf-group textarea {
    padding: 10px 0;
    border: none;
    border-bottom: 1px solid rgba(204, 255, 0, 0.15);
    font-family: var(--font-sans);
    font-size: 14px;
    background: transparent;
    color: var(--text);
    outline: none;
    resize: vertical;
    transition: border-color 0s steps(1);
  }

  .cf-group input::placeholder,
  .cf-group textarea::placeholder {
    color: rgba(242, 237, 227, 0.2);
  }

  .cf-group input:focus,
  .cf-group textarea:focus {
    border-bottom-color: var(--primary);
  }

  .cf-submit {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 12px 24px;
    background: transparent;
    color: var(--primary);
    border: 1px solid rgba(204, 255, 0, 0.4);
    cursor: pointer;
    transition: all 0s steps(1);
    margin-top: 4px;
  }

  /* The contact form is the focal point here, not a decorative section number. */
  #contact::after { display: none; }

  .cf-submit:hover {
    background: var(--primary);
    color: var(--on-primary);
    border-color: var(--primary);
    box-shadow: 0 0 12px rgba(204, 255, 0, 0.5);
  }

  .cf-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .cf-feedback {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.5px;
    min-height: 16px;
  }

  .cf-feedback.success { color: #4CAF7D; }
  .cf-feedback.error   { color: #E85A4F; }

  @media (max-width: 860px) {
    .contact-layout { grid-template-columns: 1fr; gap: 56px; }
    .contact-sub { max-width: none; }
  }

  @media (max-width: 480px) {
    .contact-heading { font-size: clamp(2rem, 8vw, 3rem); }
  }
  .cf-honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; }`n</style>

<script>
  import emailjs from '@emailjs/browser';

  const SERVICE_ID  = 'service_a8yhlt9';
  const TEMPLATE_ID = 'template_q32vjui';
  const PUBLIC_KEY  = '_wY8Z_EeqK9LiJ2lf';

  emailjs.init(PUBLIC_KEY);

  const form     = document.getElementById('contact-form') as HTMLFormElement | null;
  let lastSubmissionAt = 0;
  const btn      = document.getElementById('cf-btn') as HTMLButtonElement | null;
  const feedback = document.getElementById('cf-feedback') as HTMLParagraphElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn || !feedback || !form) return;
    const website = (form.elements.namedItem('website') as HTMLInputElement | null)?.value.trim();
    if (website) return;
    if (Date.now() - lastSubmissionAt < 30_000) {
      feedback.textContent = 'Please wait a moment before sending another message.';
      feedback.className = 'cf-feedback error';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Send message ->';
    feedback.textContent = '';
    feedback.className = 'cf-feedback';

    try {
      await emailjs.sendForm(SERVICE_ID, TEMPLATE_ID, form);
      lastSubmissionAt = Date.now();
      feedback.textContent = "Message sent. I'll get back to you soon.";
      feedback.className = 'cf-feedback success';
      form.reset();
    } catch {
      feedback.textContent = 'Something went wrong. Email me directly.';
      feedback.className = 'cf-feedback error';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send message ->';
    }
  });
</script>

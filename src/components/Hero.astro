---
// Hero - Nothing Tech pixel layout
---

<section class="hero" id="hero">

  <!-- Corner bracket markers -->
  <div class="hero-corner hc-tl" aria-hidden="true"></div>
  <div class="hero-corner hc-tr" aria-hidden="true"></div>
  <div class="hero-corner hc-bl" aria-hidden="true"></div>
  <div class="hero-corner hc-br" aria-hidden="true"></div>

  <div class="container">

    <!-- Index bar -->
    <div class="hero-index-bar">
      <span class="hib-num">001</span>
      <span class="hib-status">
        <span class="hib-dot" aria-hidden="true"></span>
        AVAILABLE FOR WORK
      </span>
      <span class="hib-coords">28.6139 deg N | 77.2090 deg E</span>
    </div>

    <div class="hero-grid">
      <div class="hero-left">

        <h1 class="hero-name">
          <span class="name-first">Akshayan</span>
          <span class="name-last">Mohandass</span>
        </h1>

        <p class="hero-role">
          <span class="role-prefix" aria-hidden="true">></span>
          Product Designer for AI-native systems<span class="cursor" aria-hidden="true"></span>
        </p>

        <p class="hero-bio">
          I turn complex workflows, roles, and business rules into clear systems
          people can trust. Currently building an
          <a href="#experience" class="bio-link">AI-native enterprise product</a> at Mondee.
          Previously Kodecopter, Bloom Majestic, Aakam 360.
        </p>

        <div class="hero-actions">
          <a href="#contact" class="cta-primary">GET IN TOUCH -></a>
          <a href="https://drive.google.com/uc?export=download&id=1JxVQMcN5wL2YpTLA3L74jXCL82JdWJon"
             target="_blank" rel="noopener noreferrer" class="cta-secondary">RESUME -></a>
          <button class="copy-btn" id="copy-email-btn" data-email="akshayanmohandass@gmail.com">
            <span class="copy-addr">akshayanmohandass@gmail.com</span>
            <span class="copy-hint">COPIED</span>
          </button>
        </div>

      </div>

      <div class="hero-right">
        <div class="hero-photo-outer">
          <!-- Photo corner marks -->
          <div class="photo-mark pm-tl" aria-hidden="true"></div>
          <div class="photo-mark pm-tr" aria-hidden="true"></div>
          <div class="photo-mark pm-bl" aria-hidden="true"></div>
          <div class="photo-mark pm-br" aria-hidden="true"></div>

          <div class="hero-photo-wrap">
            <img class="hp-bw" src="/inttial_state.jpg" alt="Akshayan Mohandass" loading="eager" />
            <img class="hp-color" src="/final_state.jpg" alt="Akshayan Mohandass" loading="eager" />
            <div class="photo-dot-overlay" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Nothing-style spec grid -->
    <div class="hero-specs">
      <div class="spec-cell">
        <span class="spec-label">Case studies</span>
        <span class="spec-val stat-num">10+</span>
        <span class="spec-unit">DOCUMENTED</span>
      </div>
      <div class="spec-cell">
        <span class="spec-label">Products shipped</span>
        <span class="spec-val stat-num">5+</span>
        <span class="spec-unit">WORKS</span>
      </div>
      <div class="spec-cell">
        <span class="spec-label">Industry verticals</span>
        <span class="spec-val stat-num">3</span>
        <span class="spec-unit">DOMAINS</span>
      </div>
      <div class="spec-cell">
        <span class="spec-label">Design scope</span>
        <span class="spec-val">0->1</span>
        <span class="spec-unit">SYSTEMS</span>
      </div>
    </div>

  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: clamp(80px, 12vh, 120px) 0 0;
    border-bottom: 1px solid rgba(204, 255, 0, 0.15);
    position: relative;
    overflow: hidden;
  }

  /* Dot matrix background */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(204, 255, 0, 0.1) 1px, transparent 0);
    background-size: 24px 24px;
    pointer-events: none;
    z-index: 0;
  }

  /* Ghost "AM" monogram */
  .hero::after {
    content: 'AM';
    position: absolute;
    bottom: -20px;
    right: -20px;
    font-family: var(--font-display);
    font-size: clamp(14rem, 30vw, 26rem);
    font-weight: 400;
    color: transparent;
    -webkit-text-stroke: 1px rgba(204, 255, 0, 0.05);
    pointer-events: none;
    line-height: 0.85;
    user-select: none;
    z-index: 0;
    letter-spacing: 0.04em;
  }

  /*  Corner bracket markers  */
  .hero-corner {
    position: absolute;
    width: 20px;
    height: 20px;
    z-index: 3;
    pointer-events: none;
  }

  .hero-corner::before,
  .hero-corner::after {
    content: '';
    position: absolute;
    background: var(--primary);
    opacity: 0.5;
  }

  .hc-tl { top: 12px; left: 12px; }
  .hc-tl::before { top: 0; left: 0; width: 20px; height: 2px; }
  .hc-tl::after  { top: 0; left: 0; width: 2px;  height: 20px; }

  .hc-tr { top: 12px; right: 12px; }
  .hc-tr::before { top: 0; right: 0; width: 20px; height: 2px; }
  .hc-tr::after  { top: 0; right: 0; width: 2px;  height: 20px; }

  .hc-bl { bottom: 0; left: 12px; }
  .hc-bl::before { bottom: 0; left: 0; width: 20px; height: 2px; }
  .hc-bl::after  { bottom: 0; left: 0; width: 2px;  height: 20px; }

  .hc-br { bottom: 0; right: 12px; }
  .hc-br::before { bottom: 0; right: 0; width: 20px; height: 2px; }
  .hc-br::after  { bottom: 0; right: 0; width: 2px;  height: 20px; }

  /*  Index bar  */
  .hero-index-bar {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 48px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(204, 255, 0, 0.1);
    position: relative;
    z-index: 1;
  }

  .hib-num {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    color: rgba(240, 240, 255, 0.2);
  }

  .hib-status {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--primary);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hib-dot {
    width: 6px;
    height: 6px;
    background: var(--primary);
    border-radius: 50%;
    animation: blink-cursor 1.4s steps(2) infinite;
  }

  .hib-coords {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 2px;
    color: rgba(240, 240, 255, 0.18);
    margin-left: auto;
  }

  /*  Main grid  */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: clamp(40px, 6vw, 80px);
    align-items: start;
    margin-bottom: 0;
    position: relative;
    z-index: 1;
  }

  /*  Name  */
  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 12vw, 11rem);
    font-weight: 400;
    line-height: 0.88;
    letter-spacing: 0.04em;
    margin-bottom: 28px;
    text-transform: uppercase;
  }

  .name-first { display: block; color: var(--text); }
  .name-last  { display: block; color: var(--primary); }

  /*  Role  */
  .hero-role {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: rgba(240, 240, 255, 0.55);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .role-prefix {
    color: var(--secondary);
    font-size: 14px;
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 13px;
    background: var(--primary);
    animation: blink-cursor 1s steps(2) infinite;
    vertical-align: middle;
  }

  /*  Bio  */
  .hero-bio {
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    color: rgba(240, 240, 255, 0.45);
    line-height: 1.85;
    max-width: 440px;
    margin-bottom: 36px;
  }

  .bio-link {
    color: var(--primary);
    border-bottom: 1px solid rgba(204, 255, 0, 0.3);
  }

  /*  Actions  */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .cta-primary {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    font-weight: 700;
    padding: 11px 22px;
    background: var(--primary);
    color: var(--on-primary);
    border: none;
    text-decoration: none;
    transition: all 0s steps(1);
  }

  .cta-primary:hover {
    background: var(--secondary);
    color: var(--text);
    box-shadow: 0 0 16px rgba(255, 20, 147, 0.5);
  }

  .cta-secondary {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 2px;
    font-weight: 700;
    padding: 10px 22px;
    background: transparent;
    color: var(--primary);
    border: 1px solid rgba(204, 255, 0, 0.35);
    text-decoration: none;
    transition: all 0s steps(1);
  }

  .cta-secondary:hover {
    background: rgba(204, 255, 0, 0.08);
    border-color: var(--primary);
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1px;
    color: rgba(240, 240, 255, 0.3);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color 0s steps(1);
  }

  .copy-btn:hover { color: rgba(240, 240, 255, 0.65); }

  .copy-hint {
    color: var(--primary);
    opacity: 0;
    transition: opacity 0s steps(1);
    font-size: 9px;
    letter-spacing: 2px;
  }

  .copy-btn:hover .copy-hint,
  .copy-btn.copied .copy-hint { opacity: 1; }
  .copy-btn.copied .copy-addr { color: var(--primary); }

  /*  Photo  */
  .hero-photo-outer {
    position: relative;
    padding: 12px;
  }

  /* Photo corner marks */
  .photo-mark {
    position: absolute;
    width: 14px;
    height: 14px;
    pointer-events: none;
    z-index: 2;
  }

  .photo-mark::before,
  .photo-mark::after {
    content: '';
    position: absolute;
    background: var(--primary);
    opacity: 0.7;
  }

  .pm-tl { top: 0; left: 0; }
  .pm-tl::before { top: 0; left: 0; width: 14px; height: 1px; }
  .pm-tl::after  { top: 0; left: 0; width: 1px;  height: 14px; }

  .pm-tr { top: 0; right: 0; }
  .pm-tr::before { top: 0; right: 0; width: 14px; height: 1px; }
  .pm-tr::after  { top: 0; right: 0; width: 1px;  height: 14px; }

  .pm-bl { bottom: 0; left: 0; }
  .pm-bl::before { bottom: 0; left: 0; width: 14px; height: 1px; }
  .pm-bl::after  { bottom: 0; left: 0; width: 1px;  height: 14px; }

  .pm-br { bottom: 0; right: 0; }
  .pm-br::before { bottom: 0; right: 0; width: 14px; height: 1px; }
  .pm-br::after  { bottom: 0; right: 0; width: 1px;  height: 14px; }

  .hero-photo-wrap {
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(204, 255, 0, 0.1);
  }

  @media (min-width: 861px) {
    .hero-photo-wrap {
      clip-path: polygon(0 0, 93% 0, 100% 7%, 100% 100%, 7% 100%, 0 93%);
    }
  }

  .hp-bw, .hp-color {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: opacity 0s steps(1);
  }

  .hp-bw    { filter: grayscale(100%) contrast(1.15); z-index: 1; }
  .hp-color { opacity: 0; z-index: 2; }

  .hero-photo-wrap:hover .hp-bw    { opacity: 0; }
  .hero-photo-wrap:hover .hp-color { opacity: 1; }

  /* Dot overlay on photo */
  .photo-dot-overlay {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(9, 9, 15, 0.5) 1px, transparent 0);
    background-size: 4px 4px;
    z-index: 3;
    pointer-events: none;
  }

  /*  Spec grid (Nothing-style)  */
  .hero-specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(204, 255, 0, 0.15);
    border-left: 1px solid rgba(204, 255, 0, 0.15);
    margin-top: 60px;
    position: relative;
    z-index: 1;
  }

  .spec-cell {
    padding: 24px 20px 20px;
    border-right: 1px solid rgba(204, 255, 0, 0.15);
    border-bottom: 1px solid rgba(204, 255, 0, 0.15);
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
  }

  .spec-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(240, 240, 255, 0.25);
  }

  .spec-val {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 400;
    color: var(--primary);
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .spec-unit {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(240, 240, 255, 0.18);
    margin-top: 2px;
  }

  /*  Responsive  */
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .hero-right { order: -1; }
    .hero-photo-outer { padding: 8px; max-width: 200px; }
    .hero-specs { grid-template-columns: repeat(2, 1fr); }
    .hib-coords { display: none; }
  }

  @media (max-width: 640px) {
    .hero-name { font-size: clamp(3.5rem, 11vw, 5rem); }
    .hero-specs { grid-template-columns: repeat(2, 1fr); margin-top: 40px; }
    .hero-actions { gap: 10px; }
  }

  @media (max-width: 480px) {
    .hero-bio { font-size: 0.88rem; }
    .hero-specs { grid-template-columns: repeat(2, 1fr); }
    .cta-primary, .cta-secondary { font-size: 10px; padding: 9px 16px; }
  }

  /*  Page load entrance  */
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(32px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-index-bar { animation: heroIn 0.5s steps(6, end) 0s    both; }
  .hero-name       { animation: heroIn 0.6s steps(8, end) 0.1s  both; }
  .hero-role       { animation: heroIn 0.5s steps(6, end) 0.22s both; }
  .hero-bio        { animation: heroIn 0.5s steps(6, end) 0.36s both; }
  .hero-actions    { animation: heroIn 0.5s steps(6, end) 0.5s  both; }
  .hero-right      { animation: heroIn 0.6s steps(8, end) 0.14s both; }
  .hero-specs      { animation: heroIn 0.5s steps(6, end) 0.65s both; }
</style>

<script>
  const btn = document.getElementById('copy-email-btn') as HTMLButtonElement | null;
  if (btn) {
    btn.addEventListener('click', () => {
      const email = btn.dataset.email ?? '';
      navigator.clipboard.writeText(email).then(() => {
        btn.classList.add('copied');
        const addr = btn.querySelector('.copy-addr') as HTMLSpanElement;
        const orig = addr.textContent ?? '';
        addr.textContent = 'Copied!';
        setTimeout(() => {
          btn.classList.remove('copied');
          addr.textContent = orig;
        }, 2000);
      });
    });
  }
</script>

---
// Selected Works - Scroll-pinned card deck
import paydartBanner from '../assets/paydart__banner.png';
import pregtrackBanner from '../assets/Pregtrack_banner.png';
import famconnectBanner from '../assets/famconnect__banner.png';
import staffezeeBanner from '../assets/staffezee_banner.png';
import pharmavaultBanner from '../assets/Pharamavault__banner.png';

const projects = [
  {
    num: "01", title: "PayDart",
    type: "FinTech | Workflow", year: "2024",
    desc: "End-to-end financial workflow system with role-based authority, real-time reporting, and automated late-fee logic.",
    proof: "40% less manual processing | Solo product design + frontend",
    link: "/projects/paydart", banner: paydartBanner, confidential: false,
  },
  {
    num: "02", title: "PregTrack",
    type: "Health Tech | Mobile", year: "2023",
    desc: "Government-approved MSME product for pregnancy tracking with evidence-based, stress-free user flows.",
    proof: "MSME certified launch | End-to-end UX + frontend support",
    link: "/projects/pregtrack-app", banner: pregtrackBanner, confidential: false,
  },
  {
    num: "03", title: "FamConnect",
    type: "Super App | Community", year: "2023",
    desc: "Unified platform for families, housing societies, and alumni communities - one app, every circle.",
    proof: "4 community types unified | Research-to-prototype ownership",
    link: "/projects/famconnect", banner: famconnectBanner, confidential: false,
  },
  {
    num: "04", title: "Staffezee",
    type: "B2B SaaS | UK Market", year: "2024",
    desc: "Bench sales management for UK IT staffing - pipelines, hotlists, and candidate tracking in one workspace.",
    proof: "Live UK SaaS | Designer, PM, and development contributor",
    link: "/projects/staffezee", banner: staffezeeBanner, confidential: false,
  },
  {
    num: "05", title: "Miraee Booking Engine",
    type: "Confidential enterprise work", year: "Confidential",
    desc: "A confidential product engagement. Detailed context is protected under NDA.",
    proof: "Details available only in a private conversation.",
    link: "/projects/miraee-booking-engine", banner: null, confidential: true,
  },
  {
    num: "06", title: "PharmaVault",
    type: "Healthcare | B2B", year: "2024",
    desc: "Pharmaceutical management built around inventory, prescriptions, and compliance-ready workflows.",
    proof: "Healthcare operations | Workflow and interface design",
    link: "/projects/pharmavault", banner: pharmavaultBanner, confidential: false,
  },];
---

<section class="projects chapter-section" id="projects">

  <div class="container">
    <header class="works-header" data-reveal>
      <div class="wh-counter">
        <span class="wh-rule"></span>
        <span class="wh-count-text">06 &nbsp;/&nbsp; CASE STUDIES</span>
        <span class="wh-rule"></span>
      </div>
      <h2 class="wh-title">
        <span class="wh-t1" data-text="SELECTED">SELECTED</span>
        <span class="wh-t2" data-text="WORK.">WORK<em>.</em></span>
      </h2>
      <div class="wh-sub">
        <span>Product Design</span><span class="wh-dot">|</span>
        <span>UX Systems</span><span class="wh-dot">|</span>
        <span>AI Products</span><span class="wh-dot">|</span>
        <span>2023 - 2024</span>
      </div>
    </header>
  </div>

  <!--
    deck-outer: tall element that creates scroll space.
    deck-sticky: sticks to viewport, clips the card stage.
    Cards are absolutely stacked inside deck-stage; JS drives transforms.
  -->
  <div class="deck-outer" id="deck-outer">
    <div class="deck-sticky" id="deck-sticky">
      <div class="deck-stage" id="deck-stage">

        {projects.map((p, i) => (
          <a href={p.confidential ? undefined : p.link} class={`deck-card ${i === 0 ? "deck-card--featured" : ""} ${p.confidential ? "deck-card--confidential" : ""}`} data-card={i} data-confidential={p.confidential ? "true" : undefined} aria-disabled={p.confidential ? "true" : undefined} aria-label={p.confidential ? `${p.title}: confidential project. Press Enter for a message.` : undefined} role={p.confidential ? "button" : undefined} tabindex={p.confidential ? 0 : undefined}>

            <div class="dc-left">
              <div class="dc-toprow">
                <span class="dc-num">{p.num}</span>
                <span class="dc-of">/ {p.year}</span>
              </div>
              <h3 class="dc-title">{p.title}</h3>
              <span class="dc-type">{p.type}</span>
              <p class="dc-desc">{p.desc}</p>
              <p class="dc-proof">{p.proof}</p>
              <div class="dc-cta">{p.confidential ? "Classified: tap for access" : "View Case Study ->"}</div>
            </div>

            <div class="dc-right">
              {p.banner ? (
              <img src={p.banner.src} alt={`${p.title} project preview`} loading="lazy" />
            ) : (
              <div class="dc-placeholder" style={`--project-accent: #6D7CFF`}>
                <span>Enterprise travel</span>
                <strong>Intent<br />before<br />itinerary.</strong>
              </div>
            )}
              <span class="dcc dcc-tl" aria-hidden="true"></span>
              <span class="dcc dcc-tr" aria-hidden="true"></span>
              <span class="dcc dcc-bl" aria-hidden="true"></span>
              <span class="dcc dcc-br" aria-hidden="true"></span>
            </div>

            <div class="dc-ghost" aria-hidden="true">{p.num}</div>
          </a>
        ))}

      </div>

      <div class="deck-dots" id="deck-dots">
        {projects.map((_, i) => (
          <span class={`dd ${i === 0 ? 'is-active' : ''}`} data-di={i}></span>
        ))}
      </div>
    </div>
  </div>

</section>

<div class="confidential-toast" id="confidential-toast" role="status" aria-live="polite"></div>
<style>
  /*  Header  */
  .works-header { margin-bottom: 32px; }

  .wh-counter { display:flex; align-items:center; gap:16px; margin-bottom:10px; }
  .wh-rule    { display:block; height:1px; flex:1; background:rgba(204,255,0,0.12); }
  .wh-count-text {
    font-family:var(--font-mono); font-size:10px; letter-spacing:3px;
    text-transform:uppercase; color:rgba(204,255,0,0.35); white-space:nowrap; flex-shrink:0;
  }

  .wh-title {
    font-family: var(--font-display);
    font-size: clamp(5rem, 11vw, 11rem);
    line-height: .9;
    letter-spacing: .015em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .wh-t1 { display: block; color: rgba(243, 245, 244, .34); }
  .wh-t1::before { display: none; }
  .wh-t2 { display: block; color: var(--text); }
  .wh-t2::before { display: none; }
  .wh-t2 em { color:var(--primary); font-style:normal; }
  .wh-sub {
    display:flex; align-items:center; gap:10px; flex-wrap:wrap;
    font-family:var(--font-mono); font-size:10px; letter-spacing:2px;
    text-transform:uppercase; color:rgba(242,237,227,0.2);
  }
  .wh-dot { color:rgba(204,255,0,0.25); }

  /*  Scroll space  */
  .deck-outer {
    /* JS overrides this; fallback keeps layout sane */
    height: 3200px;
    position: relative;
  }

  /*  Sticky viewport  */
  .deck-sticky {
    position: sticky;
    top: 80px;
    height: calc(100vh - 96px);
    display: flex;
    flex-direction: column;
    max-width: 1280px;
    width: 100%;
    margin: 0 auto;
    padding: 0 32px;
  }

  /*  Card stage  */
  .deck-stage {
    flex: 1;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(204,255,0,0.1);
  }

  /*  Cards  */
  .deck-card {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 42% 58%;
    background: var(--bg);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    will-change: transform, opacity;
    transform-origin: top center;
    /* All start below except first */
    transform: translateY(100%);
    opacity: 0;
  }

  .deck-card--confidential {
    cursor: default;
  }
  .deck-card--confidential .dc-cta { color: rgba(243,245,244,.48); }
  .deck-card--confidential .dc-placeholder { filter: saturate(.55); }
  .deck-card:first-child {
    transform: translateY(0);
    opacity: 1;
  }

  /*  Left  */
  .dc-left {
    padding: clamp(24px,4vh,48px) 36px clamp(20px,3vh,40px) 32px;
    display: flex; flex-direction: column; gap: 14px;
    border-right: 1px solid rgba(204,255,0,0.07);
    position: relative; z-index: 2; overflow: hidden;
  }

  .dc-toprow {
    display: flex; align-items: baseline; gap: 8px;
  }

  .dc-num {
    font-family:var(--font-mono); font-size:10px; letter-spacing:2px;
    color:rgba(204,255,0,0.5);
  }

  .dc-of {
    font-family:var(--font-mono); font-size:9px;
    color:rgba(242,237,227,0.15); letter-spacing:1px;
  }

  .dc-title {
    font-family:var(--font-display);
    font-size:clamp(3rem,6vw,7rem);
    font-weight:400; line-height:0.88;
    letter-spacing:0.04em; text-transform:uppercase;
    color:var(--text); flex-shrink:0;
    transition: color 0.2s ease;
  }

  .deck-card:hover .dc-title { color:var(--primary); }

  .dc-type {
    font-family:var(--font-mono); font-size:9px; letter-spacing:2px;
    text-transform:uppercase; color:rgba(242,237,227,0.3);
    border:1px solid rgba(204,255,0,0.1); padding:4px 10px; align-self:flex-start;
  }

  .dc-proof {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid rgba(183,243,91,.16);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 1px;
    line-height: 1.55;
    text-transform: uppercase;
  }

  .dc-placeholder {
    display: flex;
    min-height: 100%;
    padding: clamp(24px, 4vw, 48px);
    flex-direction: column;
    justify-content: space-between;
    background: linear-gradient(145deg, color-mix(in srgb, var(--project-accent) 28%, #101214), #101214 68%);
    color: var(--text);
  }
  .dc-placeholder span { color: var(--primary); font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px; text-transform: uppercase; }
  .dc-placeholder strong { font-family: var(--font-display); font-size: clamp(3rem, 5vw, 6rem); font-weight: 400; letter-spacing: .03em; line-height: .84; text-transform: uppercase; }
  .dc-desc {
    font-size:13px; color:rgba(242,237,227,0.4); line-height:1.75; flex:1;
  }

  .dc-cta {
    display:flex; align-items:center; gap:8px;
    font-family:var(--font-mono); font-size:10px; letter-spacing:2px;
    text-transform:uppercase; color:rgba(204,255,0,0.35);
    padding-top:14px; border-top:1px solid rgba(204,255,0,0.07); margin-top:auto;
    transition: color 0.2s ease;
  }

  .deck-card:hover .dc-cta { color:var(--primary); }
  .dc-arr { transition: transform 0.2s ease; }
  .deck-card:hover .dc-arr { transform:translate(3px,-3px); }

  /*  Right (image)  */
  .dc-right {
    position:relative; overflow:hidden; display:grid; place-items:center; background:#0b0d0f;
  }

  .dc-right img {
    width:100%; height:100%; object-fit:contain; object-position:center;
    mix-blend-mode:luminosity; opacity:0.45; filter:contrast(1.1);
    transition: opacity 0.35s ease, mix-blend-mode 0.35s ease;
  }

  .deck-card:hover .dc-right img {
    opacity:0.75; mix-blend-mode:normal;
  }

  .dcc {
    position:absolute; width:15px; height:15px;
    border-color:rgba(204,255,0,0.3); border-style:solid;
    z-index:3; pointer-events:none; opacity:0; transition:opacity 0.2s ease;
  }
  .deck-card:hover .dcc { opacity:1; }
  .dcc-tl { top:12px;    left:12px;    border-width:1px 0 0 1px; }
  .dcc-tr { top:12px;    right:12px;   border-width:1px 1px 0 0; }
  .dcc-bl { bottom:12px; left:12px;    border-width:0 0 1px 1px; }
  .dcc-br { bottom:12px; right:12px;   border-width:0 1px 1px 0; }

  /* Ghost number */
  .dc-ghost {
    position:absolute; bottom:-12px; left:-6px;
    font-family:var(--font-display);
    font-size:clamp(7rem,14vw,13rem); line-height:1; letter-spacing:0.04em;
    color:transparent; -webkit-text-stroke:1px rgba(204,255,0,0.04);
    pointer-events:none; user-select:none; z-index:1;
  }

  /*  Progress dots  */
  .deck-dots {
    display:flex; justify-content:center; align-items:center;
    gap:8px; padding:12px 0 8px;
    flex-shrink:0; border-top:1px solid rgba(204,255,0,0.06);
  }

  .dd {
    display:block; width:20px; height:2px;
    background:rgba(242,237,227,0.12);
    transition: width 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
  }

  .dd.is-active {
    background:var(--primary); width:36px;
    box-shadow:0 0 6px rgba(204,255,0,0.5);
  }

  /*  Mobile  */
  @media (max-width: 768px) {
    .deck-card { grid-template-columns:1fr; grid-template-rows:1fr 200px; }
    .dc-left { border-right:none; border-bottom:1px solid rgba(204,255,0,0.07); padding:24px; }
    .dc-title { font-size:clamp(2.5rem,9vw,4rem); }
    .deck-sticky { top:64px; height:calc(100vh - 80px); }
  }

  @media (max-width: 480px) {
    .wh-t1, .wh-t2 { font-size:clamp(3rem,14vw,6rem); }
    .dc-desc { font-size:12px; }
  }

  /* Evidence index: quick to scan, rich enough to assess. */
  .deck-outer { height: auto !important; max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .deck-sticky { position: static; height: auto; max-width: none; padding: 0; }
  .deck-stage { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; overflow: visible; border: 0; }
  .deck-card, .deck-card:first-child {
    position: relative; inset: auto; min-height: 360px; display: grid; grid-template-columns: 1fr;
    border: 1px solid rgba(183, 243, 91, 0.16); background: var(--white); opacity: 1 !important;
    transform: none !important; transition: border-color .2s ease, transform .2s ease, background .2s ease;
  }
  .deck-card:hover { border-color: rgba(183, 243, 91, 0.68); transform: translateY(-4px) !important; background: var(--cream); }
  .deck-card--featured { grid-column: 1 / -1; grid-template-columns: minmax(0, .88fr) minmax(360px, 1.12fr); min-height: 500px; }
  .deck-card--featured .dc-left { padding: clamp(32px, 5vw, 64px); }
  .deck-card--featured .dc-title { font-size: clamp(4.4rem, 8vw, 8rem); }
  .deck-card--featured .dc-right { grid-column: 2; grid-row: 1; }
  .dc-left { padding: 28px; border-right: 0; border-bottom: 1px solid rgba(183, 243, 91, 0.12); }
  .dc-right { min-height: 220px; }
  .dc-right img { opacity: .82; mix-blend-mode: normal; filter: contrast(1.03) saturate(.9); }
  .deck-card:hover .dc-right img { opacity: 1; }
  .dc-desc { max-width: 44ch; color: rgba(243, 245, 244, .72); font-size: 14px; }
  .dc-type { color: rgba(243, 245, 244, .68); border-color: rgba(183, 243, 91, .24); }
  .dc-cta { color: var(--primary); }
  .deck-dots, .dc-ghost { display: none; }
  @media (max-width: 760px) {
    .deck-outer { padding: 0 16px; }
    .deck-stage, .deck-card--featured { grid-template-columns: 1fr; }
    .deck-card--featured .dc-right { grid-column: auto; grid-row: auto; }
    .deck-card, .deck-card--featured { min-height: auto; }
    .deck-card--featured .dc-title { font-size: clamp(3.3rem, 16vw, 5.5rem); }
  }</style>

<style>
  .deck-card--featured {
    grid-template-columns: 46% 54% !important;
    height: 500px;
    min-height: 500px;
  }
  .deck-card--featured .dc-right {
    min-height: 0;
    height: 500px;
  }
  .deck-card--featured .dc-right img { height: 100%; }
  /* Complete the final row: PharmaVault uses the full card width. */
  .deck-card:last-child {
    grid-column: 1 / -1;
    grid-template-columns: 46% 54%;
    min-height: 500px;
  }
  .deck-card:last-child .dc-right {
    grid-column: 2;
    grid-row: 1;
    min-height: 0;
    height: 500px;
  }
  .deck-card:last-child .dc-right img { height: 100%; }
  @media (max-width: 760px) {
    .deck-card--featured { grid-template-columns: 1fr; height: auto; min-height: auto; }
    .deck-card--featured .dc-right { height: 240px; }
  }
  /* Soft corners keep the selected-work deck consistent with the portfolio's refined surfaces. */
  .deck-card { border-radius: 18px; border: 1px solid rgba(183,243,91,.18); }
  .deck-card .dc-left { border-radius: 18px 0 0 18px; }
  .deck-card .dc-right { border-radius: 0 18px 18px 0; }
  @media (max-width: 860px) { .deck-card .dc-left { border-radius: 18px 18px 0 0; } .deck-card .dc-right { border-radius: 0 0 18px 18px; } }

</style>
<style>
  /* Replace the decorative display lockup with an editorial section header. */
  .works-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 18px 32px;
    margin-bottom: 32px;
  }
  .wh-counter {
    grid-column: 1 / -1;
    justify-content: space-between;
    margin: 0;
  }
  .wh-rule { display: none; }
  .wh-count-text { color: var(--primary); font-size: 10px; }
  .wh-title {
    font-family: var(--font-display);
    font-size: clamp(5rem, 11vw, 11rem);
    line-height: .9;
    letter-spacing: .015em;
    text-transform: uppercase;
    margin: 0 0 16px;
  }
  .wh-t1, .wh-t2 {
    display: inline;
    font-size: inherit;
    -webkit-text-stroke: 0;
  }
  .wh-t1 { display: block; color: rgba(243, 245, 244, .34); }
  .deck-card--confidential { cursor: pointer; }
  .deck-card--confidential:hover { border-color: var(--secondary); }
  .confidential-toast {
    position: fixed;
    left: 50%; bottom: 28px;
    z-index: 10000;
    width: min(440px, calc(100vw - 32px));
    padding: 14px 18px;
    border: 1px solid var(--primary);
    background: #101214;
    box-shadow: 0 12px 40px rgba(0,0,0,.45);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1px;
    line-height: 1.5;
    text-align: center;
    transform: translate(-50%, 120%);
    opacity: 0;
    pointer-events: none;
    transition: transform .25s ease, opacity .25s ease;
  }
  .confidential-toast.is-visible { transform: translate(-50%, 0); opacity: 1; }</style>
<script src="../scripts/confidential-project.ts"></script>
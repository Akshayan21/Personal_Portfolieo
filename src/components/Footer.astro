---
// Footer - Minimal endcap
const year = new Date().getFullYear();
---

<footer class="footer" id="footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-left">
        <span class="footer-logo">AM</span>
        <p class="footer-tagline">Designing intelligent systems<br/>for people who build things.</p>
      </div>
      <nav class="footer-nav">
        <a href="#about" class="footer-link">About</a>
        <a href="#experience" class="footer-link">Experience</a>
        <a href="#projects" class="footer-link">Work</a>
        <a href="#skills" class="footer-link">Skills</a>
        <a href="#philosophy" class="footer-link">Philosophy</a>
        <a href="#contact" class="footer-link">Contact</a>
      </nav>
    </div>

    <div class="footer-bottom">
      <p>(c) {year} Akshayan Mohandass</p>
      <p>Product Designer | Systems Thinker</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg);
    border-top: 1px solid rgba(204, 255, 0, 0.12);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 56px 0 40px;
    border-bottom: 1px solid rgba(204, 255, 0, 0.08);
    gap: 32px;
    flex-wrap: wrap;
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5vw, 4.5rem);
    font-weight: 400;
    font-style: normal;
    color: var(--primary);
    display: block;
    margin-bottom: 16px;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
    position: relative;
    text-shadow: 0 0 20px rgba(204, 255, 0, 0.3);
  }

  .footer-logo::before {
    content: 'AM';
    position: absolute;
    top: 4px;
    left: 4px;
    color: transparent;
    -webkit-text-stroke: 1px rgba(204, 255, 0, 0.18);
    pointer-events: none;
    user-select: none;
    z-index: -1;
    letter-spacing: inherit;
  }

  .footer-tagline {
    font-size: 13px;
    color: rgba(242, 237, 227, 0.3);
    line-height: 1.6;
  }

  .footer-nav {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    align-items: flex-start;
    padding-top: 4px;
  }

  .footer-link {
    font-size: 13px;
    color: rgba(242, 237, 227, 0.35);
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--text);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    padding: 20px 0;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer-bottom p {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(242, 237, 227, 0.2);
  }

  @media (max-width: 640px) {
    .footer-inner { flex-direction: column; padding: 40px 0 32px; }
    .footer-nav { gap: 16px; }
    .footer-bottom { flex-direction: column; gap: 6px; }
  }
</style>

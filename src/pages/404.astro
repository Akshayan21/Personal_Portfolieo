---
import Layout from '../layouts/Layout.astro';
import { pageUrl, projectUrl } from '../data/urls';

const routes = [
  { index: '01', label: 'Selected work', href: `${pageUrl('/')}#projects` },
  { index: '02', label: 'About Akshayan', href: `${pageUrl('/')}#about` },
  { index: '03', label: 'PregTrack case study', href: projectUrl('pregtrack-app') },
];
---

<Layout title="Page not found | Akshayan Mohandass" description="The requested page could not be found. Return to Akshayan Mohandass's product design portfolio." showAura={false}>
  <main class="lost-page" id="main-content">
    <header class="lost-nav">
      <a class="brand" href={pageUrl('/')} aria-label="Akshayan Mohandass portfolio home">
        <span class="brand-mark mono">AM</span>
        <span class="brand-copy"><strong>Akshayan Mohandass</strong><small class="mono">Product designer / portfolio</small></span>
      </a>
      <span class="system-state mono"><i></i> Route unavailable</span>
    </header>

    <section class="lost-stage" aria-labelledby="lost-title">
      <div class="lost-copy">
        <p class="eyebrow mono"><span>ERR_404</span> / THE PATH ENDS HERE</p>
        <h1 id="lost-title">Off the<br /><em>map.</em></h1>
        <p class="message">The page you followed is no longer at this address. The work is still here—take a clearer route back in.</p>
        <a class="primary-route" href={pageUrl('/')}><span>Return to the portfolio</span><span aria-hidden="true">↗</span></a>
      </div>

      <div class="error-display" aria-hidden="true">
        <span class="display-index mono">HTTP / NOT FOUND</span>
        <span class="display-number">404</span>
        <div class="route-line"><i></i><i></i><i></i></div>
        <span class="display-coordinate mono">00.000 / NULL</span>
      </div>
    </section>

    <nav class="route-list" aria-label="Useful portfolio destinations">
      <p class="route-heading mono">AVAILABLE ROUTES</p>
      <div class="route-links">
        {routes.map((route) => (
          <a href={route.href}><span class="mono">{route.index}</span><strong>{route.label}</strong><i aria-hidden="true">↗</i></a>
        ))}
      </div>
    </nav>

    <footer class="lost-footer mono"><span>AKSHAYAN / PRODUCT DESIGN</span><span>STATUS 404</span></footer>
  </main>
</Layout>

<style>
  .lost-page {
    --line: rgba(183, 243, 91, 0.18);
    min-height: 100dvh;
    width: min(100%, 1440px);
    margin: 0 auto;
    padding: 0 clamp(22px, 5vw, 72px);
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    overflow: hidden;
  }
  .lost-nav { min-height: 88px; display: flex; align-items: center; justify-content: space-between; gap: 24px; border-bottom: 1px solid var(--line); }
  .brand { display: flex; align-items: center; gap: 14px; }
  .brand-mark { display: grid; place-items: center; width: 42px; height: 42px; color: var(--on-primary); background: var(--primary); font-size: .72rem; font-weight: 700; }
  .brand-copy { display: grid; gap: 2px; }
  .brand-copy strong { color: var(--text); font-size: .9rem; font-weight: 600; }
  .brand-copy small, .system-state { color: var(--grey); font-size: .58rem; letter-spacing: .12em; text-transform: uppercase; }
  .system-state { display: flex; align-items: center; gap: 9px; }
  .system-state i { width: 7px; height: 7px; border-radius: 50%; background: var(--primary); box-shadow: 0 0 14px rgba(183, 243, 91, .65); }
  .lost-stage { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, .82fr); align-items: center; gap: clamp(48px, 8vw, 130px); padding: clamp(72px, 9vw, 130px) 0 clamp(56px, 7vw, 96px); }
  .lost-copy { position: relative; z-index: 1; }
  .eyebrow { margin-bottom: 28px; color: var(--grey); font-size: .66rem; font-weight: 700; letter-spacing: .18em; }
  .eyebrow span { color: var(--primary); }
  h1 { max-width: 650px; margin: 0; color: var(--text); font-family: var(--font-display); font-size: clamp(5.7rem, 11vw, 10.5rem); font-weight: 400; line-height: .75; letter-spacing: .015em; text-transform: uppercase; }
  h1 em { color: var(--primary); font-style: normal; }
  .message { max-width: 50ch; margin: 38px 0 34px; color: var(--dark-grey); font-size: clamp(1rem, 1.6vw, 1.18rem); line-height: 1.7; text-wrap: pretty; }
  .primary-route { width: fit-content; min-width: 270px; padding: 16px 18px; display: flex; align-items: center; justify-content: space-between; gap: 30px; color: var(--on-primary); background: var(--primary); font-family: var(--font-mono); font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; transition: transform .2s ease, background .2s ease; }
  .primary-route span:last-child { font-size: 1rem; transition: transform .2s ease; }
  .primary-route:hover { background: var(--text); transform: translateY(-2px); }
  .primary-route:hover span:last-child { transform: translate(2px, -2px); }
  .primary-route:active { transform: translateY(0) scale(.985); }
  .primary-route:focus-visible, .route-links a:focus-visible, .brand:focus-visible { outline: 2px solid var(--primary); outline-offset: 5px; }
  .error-display { position: relative; min-height: clamp(350px, 41vw, 560px); display: grid; align-content: center; border: 1px solid var(--line); background: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px), radial-gradient(circle at 50% 50%, rgba(183, 243, 91, .07), transparent 55%); background-size: 54px 54px, 54px 54px, auto; clip-path: polygon(0 22px, 22px 0, 100% 0, 100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%); }
  .error-display::before, .error-display::after { content: ''; position: absolute; width: 44px; height: 2px; background: var(--primary); }
  .error-display::before { top: -1px; left: 22px; }
  .error-display::after { right: 22px; bottom: -1px; }
  .display-index, .display-coordinate { position: absolute; color: var(--grey); font-size: .58rem; letter-spacing: .14em; }
  .display-index { top: 28px; left: 28px; }
  .display-coordinate { right: 28px; bottom: 26px; }
  .display-number { color: transparent; font-family: var(--font-display); font-size: clamp(9rem, 18vw, 17rem); line-height: .75; letter-spacing: -.02em; text-align: center; -webkit-text-stroke: 1px rgba(243, 245, 244, .72); }
  .route-line { position: absolute; left: 12%; right: 12%; top: 50%; display: flex; align-items: center; justify-content: space-between; }
  .route-line::before { content: ''; position: absolute; left: 0; right: 0; height: 1px; background: var(--primary); opacity: .5; }
  .route-line i { position: relative; width: 8px; height: 8px; border: 1px solid var(--primary); background: var(--bg); transform: rotate(45deg); }
  .route-list { padding: 24px 0 30px; border-top: 1px solid var(--line); }
  .route-heading { margin-bottom: 15px; color: var(--primary); font-size: .6rem; font-weight: 700; letter-spacing: .18em; }
  .route-links { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .route-links a { min-height: 76px; padding: 0 20px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; border-right: 1px solid var(--line); transition: color .2s ease, background .2s ease; }
  .route-links a:first-child { padding-left: 0; }
  .route-links a:last-child { border-right: 0; }
  .route-links span { color: var(--grey); font-size: .6rem; }
  .route-links strong { color: var(--text); font-size: .85rem; font-weight: 500; }
  .route-links i { color: var(--primary); font-style: normal; transition: transform .2s ease; }
  .route-links a:hover { background: rgba(183, 243, 91, .045); }
  .route-links a:hover i { transform: translate(2px, -2px); }
  .lost-footer { min-height: 56px; display: flex; align-items: center; justify-content: space-between; color: var(--grey); font-size: .55rem; letter-spacing: .12em; }
  @media (max-width: 820px) {
    .lost-stage { grid-template-columns: 1fr; gap: 54px; padding-top: 64px; }
    .error-display { min-height: 340px; order: -1; }
    .display-number { font-size: clamp(10rem, 45vw, 15rem); }
    .route-links { grid-template-columns: 1fr; }
    .route-links a, .route-links a:first-child { padding: 0 4px; border-right: 0; border-bottom: 1px solid var(--line); }
    .route-links a:last-child { border-bottom: 0; }
  }
  @media (max-width: 520px) {
    .lost-page { padding-inline: 18px; }
    .lost-nav { min-height: 74px; }
    .brand-copy small, .system-state { display: none; }
    .lost-stage { padding: 42px 0 52px; gap: 46px; }
    .error-display { min-height: 270px; }
    h1 { font-size: clamp(5.2rem, 27vw, 7.4rem); }
    .message { margin-top: 30px; }
    .primary-route { width: 100%; min-width: 0; }
    .lost-footer span:first-child { display: none; }
    .lost-footer { justify-content: flex-end; }
  }
  @media (prefers-reduced-motion: reduce) { .primary-route, .primary-route span, .route-links a, .route-links i { transition: none; } }
</style>

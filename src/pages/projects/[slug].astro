---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { pageUrl, publicProjectSlugs, projectUrl } from '../../data/urls';
import { projects, type Project } from '../../data/projects';

import paydartBanner from '../../assets/paydart__banner.png';
import pregtrackBanner from '../../assets/Pregtrack_banner.png';
import famconnectBanner from '../../assets/famconnect__banner.png';
import staffezeeBanner from '../../assets/staffezee_banner.png';
import pharmavaultBanner from '../../assets/Pharamavault__banner.png';
import paydartLogin from '../../assets/paydart/paydart _Login_screen.png';
import paydartDashboard from '../../assets/paydart/Paydart_Dashboard.png';
import paydartFeeDetails from '../../assets/paydart/Paydart_fees_Details.png';
import paydartPaymentHistory from '../../assets/paydart/Paydart_payment_history.png';
import paydartReceipt from '../../assets/paydart/Paydart_recipet_Generatore_screen.png';
import pregtrackLogin from '../../assets/pregtrack/Login Screen.png';
import pregtrackProfile from '../../assets/pregtrack/Detailes Gathering.png';
import pregtrackDueDate from '../../assets/pregtrack/Due Date Calculation.png';
import pregtrackDashboard from '../../assets/pregtrack/User Dashboard.png';
import pregtrackTimeline from '../../assets/pregtrack/Time Line.png';
import pregtrackGrowth from '../../assets/pregtrack/Baby Growth Chart Screen.png';
import pregtrackHospitals from '../../assets/pregtrack/Hospitals.png';
import famconnectOnboardingOne from '../../assets/Famconnet/Onboarding Screen 1.png';
import famconnectOnboardingTwo from '../../assets/Famconnet/Onboarding Screen 2.png';
import famconnectOnboardingThree from '../../assets/Famconnet/Onboarding Screen 3.png';
import famconnectVerification from '../../assets/Famconnet/Verification screen.png';
import famconnectAccountConfirmation from '../../assets/Famconnet/Account Confiremation.png';
import famconnectPersonalDetails from '../../assets/Famconnet/Sign Up (Personal Details Capturing Screen).png';
import famconnectFamilyIntro from '../../assets/Famconnet/Family Adding Intro.png';
import famconnectFamilyCreation from '../../assets/Famconnet/Sign Up (Family Creating Screen).png';
import famconnectFamilyInvitation from '../../assets/Famconnet/Sign Up (Invitation for Joining Family).png';
import famconnectAddress from '../../assets/Famconnet/Sign Up (Address Capturing Screen).png';
import famconnectSchoolDetails from '../../assets/Famconnet/Sign Up (School Capturing Screen).png';
import famconnectSchoolDetailsMore from '../../assets/Famconnet/Sign Up (School Capturing Screen)-1.png';
import famconnectSchoolCreation from '../../assets/Famconnet/Sign Up (School Creation).png';

const bannerMap: Record<string, ImageMetadata> = {
  'paydart': paydartBanner,
  'pregtrack-app': pregtrackBanner,
  'famconnect': famconnectBanner,
  'staffezee': staffezeeBanner,
  'pharmavault': pharmavaultBanner,
};

const publicProjects = projects.filter((project) => publicProjectSlugs.includes(project.slug));

export function getStaticPaths() {
  return projects.filter((project) => publicProjectSlugs.includes(project.slug)).map((project) => ({ params: { slug: project.slug } }));
}

const { slug } = Astro.params;
const project = publicProjects.find((item) => item.slug === slug);
if (!project) return Astro.redirect('/');

const currentIndex = publicProjects.findIndex((item) => item.slug === slug);
const prevProject = publicProjects[currentIndex - 1] ?? null;
const nextProject = publicProjects[currentIndex + 1] ?? null;
const banner = slug ? bannerMap[slug] ?? null : null;
const paydartScreenMap: Record<string, ImageMetadata> = {
  'Login': paydartLogin,
  'Student Overview': paydartDashboard,
  'Upcoming Fees': paydartFeeDetails,
  'Payment History': paydartPaymentHistory,
  'Digital Receipt': paydartReceipt,
};
const pregtrackScreenMap: Record<string, ImageMetadata> = {
  'Sign In': pregtrackLogin,
  'Profile Setup': pregtrackProfile,
  'Due Date Setup': pregtrackDueDate,
  'Dashboard': pregtrackDashboard,
  'Pregnancy Timeline': pregtrackTimeline,
  'Baby Growth Chart': pregtrackGrowth,
  'Hospital Discovery': pregtrackHospitals,
};
const famconnectScreenMap: Record<string, ImageMetadata> = {
  'Welcome to FamConnect': famconnectOnboardingOne,
  'Private Community Spaces': famconnectOnboardingTwo,
  'Stay Connected': famconnectOnboardingThree,
  'Account Verification': famconnectVerification,
  'Account Confirmation': famconnectAccountConfirmation,
  'Personal Details': famconnectPersonalDetails,
  'Family Setup Introduction': famconnectFamilyIntro,
  'Create a Family': famconnectFamilyCreation,
  'Join a Family': famconnectFamilyInvitation,
  'Add an Address': famconnectAddress,
  'School Details': famconnectSchoolDetails,
  'School Information': famconnectSchoolDetailsMore,
  'Create a School Community': famconnectSchoolCreation,
};
const screenMaps: Record<string, Record<string, ImageMetadata>> = {
  paydart: paydartScreenMap,
  'pregtrack-app': pregtrackScreenMap,
  famconnect: famconnectScreenMap,
};
const getScreenImage = (screen: Project['screens'][number]) => screenMaps[project.slug]?.[screen.title];
const screenImages = project.screens.map(screen => ({ screen, image: getScreenImage(screen) })).filter(item => item.image);
const textOnlyScreens = project.screens.filter(screen => !getScreenImage(screen));
const hasScreenImages = screenImages.length > 0;
---

<Layout 
  title={`${project.title} | ${project.type} Case Study - Akshayan Mohandass`}
  description={project.desc}
  ogImage={banner?.src ?? "/final_state.jpg"}
  ogImageAlt={banner ? `${project.title} UX case study cover` : `${project.title} case study by Akshayan Mohandass`}
  ogType="article"
  showAura={false}
  keywords={`${project.title}, ${project.type}, ${project.tools.join(', ')}, ${project.tags.join(', ')}, Akshayan Mohandass, Product Design Case Study`}
>
  <div class="case-study">
    <a class="cs-skip" href="#cs-overview">Skip to case study</a>

      <!--  TOP NAV  -->
      <nav class="cs-topnav" id="cs-topnav" aria-label="Case study navigation">
      <div class="cs-topnav-inner">
        <a href={pageUrl('/')} class="cs-back">Back to home</a>
        <span class="cs-breadcrumb mono">
          <a href={pageUrl('/')}>Home</a> / {project.title}
        </span>
      </div>
    </nav>

    <!--  HERO  -->
    <header class="cs-hero" id="cs-hero" style={`--accent: ${project.accent}; --accent-dark: ${project.accentDark}`}>
      <div class="cs-container">
        <span class="cs-type-badge mono">{project.type}</span>
        <h1 class="cs-title">{project.title}</h1>
        <p class="cs-tagline">{project.desc}</p>

        <div class="cs-meta-strip">
          <div class="cs-meta-item">
            <span class="cmi-label mono">ROLE</span>
            <span class="cmi-val">{project.role}</span>
          </div>
          <div class="cs-meta-item">
            <span class="cmi-label mono">COMPANY</span>
            <span class="cmi-val">{project.company}</span>
          </div>
          <div class="cs-meta-item">
            <span class="cmi-label mono">DURATION</span>
            <span class="cmi-val">{project.duration}</span>
          </div>
          <div class="cs-meta-item">
            <span class="cmi-label mono">YEAR</span>
            <span class="cmi-val">{project.year}</span>
          </div>
          <div class="cs-meta-item">
            <span class="cmi-label mono">TOOLS</span>
            <span class="cmi-val">{project.tools.join(' | ')}</span>
          </div>
        </div>

        <div class="cs-executive-summary" aria-label="Project snapshot">
          <div><span class="mono">MY ROLE</span><strong>{project.role}</strong></div>
          <div><span class="mono">TEAM</span><strong>{project.team}</strong></div>
          <div><span class="mono">EVIDENCE</span><strong>{project.outcomes[0]?.metric} {project.outcomes[0]?.label}</strong></div>
        </div>
      </div>
    </header>

    <!--  HERO VISUAL  -->
    <div class="cs-hero-visual" style={`--accent: ${project.accent}`}>
      <div class="cs-container">
        <div class="cs-cover-placeholder">
          <div class="cs-cover-browser">
            <div class="cs-cover-bar">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
              <span class="cs-cover-url mono">{project.company.toLowerCase().replace(/\s/g, '')}.design / {project.slug}</span>
            </div>
            <div class={`cs-cover-screen ${banner ? 'has-banner' : ''}`}>
              {banner ? (
                <Image src={banner} alt={`${project.title} UX case study cover showing the product interface`} title={`${project.title} case study cover`} widths={[640, 960, 1280]} sizes="(max-width: 1100px) 100vw, 1100px" format="webp" quality={82} class="cs-cover-banner-img" loading="eager" decoding="async" fetchpriority="high" />
              ) : null}
            </div>
          </div>
        </div>
      </div>
    </div>

    <nav class="cs-case-toc" aria-label="Case study sections">
      <div class="cs-container">
        <a href="#cs-overview">Overview</a><a href="#cs-challenge">Challenge</a><a href="#cs-research">Research</a><a href="#cs-process">Process</a>{project.strategy && <a href="#cs-strategy">Strategy</a>}<a href="#cs-screens">Solution</a><a href="#cs-decisions">Decisions</a><a href="#cs-outcomes">Outcomes</a>{project.nextSteps && <a href="#cs-next">Next</a>}<a href="#cs-learnings">Learnings</a>
      </div>
    </nav>

    <main class="cs-container cs-body">

      <!--  OVERVIEW  -->
      <section class="cs-section" id="cs-overview">
        <div class="cs-overview-grid">
          <div class="cs-overview-left">
            <h2 class="cs-section-label mono">OVERVIEW</h2>
            <p class="cs-overview-text">{project.overview}</p>
          </div>
          <div class="cs-overview-right">
            {project.outcomes.slice(0, 1).map(o => (
              <div class="cs-stat-hero" style={`--accent: ${project.accent}`}>
                <span class="cs-stat-num">{o.metric}</span>
                <span class="cs-stat-label mono">{o.label}</span>
                {project.liveUrl && (
                  <a
                    class="cs-stat-action mono"
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Open ${project.title} on Google Play in a new tab`}
                  >
                    <span>{project.liveLabel ?? 'View live product'}</span>
                    <span class="cs-stat-action-arrow" aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            ))}
            <div class="cs-team-card">
              <span class="cmi-label mono">TEAM</span>
              <span class="cs-team-val">{project.team}</span>
            </div>
          </div>
        </div>
      </section>

      {project.responsibilities && (
        <section class="cs-section" id="cs-ownership">
          <h2 class="cs-section-label mono">OWNERSHIP & RESPONSIBILITIES</h2>
          <div class="cs-responsibility-grid">
            {project.responsibilities.map((item, i) => (
              <div class="cs-responsibility-item"><span class="mono">{String(i + 1).padStart(2, '0')}</span><p>{item}</p></div>
            ))}
          </div>
        </section>
      )}

      <!--  THE CHALLENGE  -->
      <section class="cs-section" id="cs-challenge">
        <h2 class="cs-section-label mono">THE CHALLENGE</h2>
        <div class="cs-challenge-grid">
          <div class="cs-challenge-left">
            <p class="cs-challenge-text">{project.problem}</p>
          </div>
          <div class="cs-challenge-right">
            <div class="cs-pain-list">
              <div class="cs-pain-header mono">PAIN POINTS IDENTIFIED</div>
              {project.painPoints.map((p, i) => (
                <div class="cs-pain-item">
                  <span class="cs-pain-num mono">{String(i + 1).padStart(2, '0')}</span>
                  <span class="cs-pain-text">{p}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!--  RESEARCH & DISCOVERY  -->
      <section class="cs-section" id="cs-research">
        <h2 class="cs-section-label mono">RESEARCH & DISCOVERY</h2>
        <div class="cs-research-grid">
          {project.researchMethods.map((m, i) => (
            <div class="cs-research-card" style={`--delay: ${i * 0.08}s`}>
              <span class="cs-research-num mono" style={`color: ${project.accent}`}>{String(i + 1).padStart(2, '0')}</span>
              <span class="cs-research-label">{m.label}</span>
              <span class="cs-research-desc mono">{m.desc}</span>
            </div>
          ))}
        </div>

        <div class="cs-insights">
          <div class="cs-insights-header">
            <span class="mono">KEY INSIGHTS *</span>
          </div>
          {project.insights.map((insight, i) => (
            <div class="cs-insight-row">
              <span class="cs-insight-num mono" style={`color: ${project.accent}`}>{String(i + 1).padStart(2, '0')}</span>
              <span class="cs-insight-text">{insight}</span>
            </div>
          ))}
        </div>
      </section>

      <!--  DESIGN PROCESS  -->
      <section class="cs-section" id="cs-process">
        <h2 class="cs-section-label mono">DESIGN PROCESS</h2>
        <div class="cs-process-track">
          {project.processSteps.map((step, i) => (
            <div class="cs-process-step" style={`--accent: ${project.accent}`}>
              <div class="cs-ps-num mono">{step.num}</div>
              <div class="cs-ps-content">
                <div class="cs-ps-title">{step.title}</div>
                <div class="cs-ps-desc mono">{step.desc}</div>
              </div>
              {i < project.processSteps.length - 1 && (
                <div class="cs-ps-arrow">-></div>
              )}
            </div>
          ))}
        </div>
      </section>

      {project.strategy && (
        <section class="cs-section" id="cs-strategy">
          <h2 class="cs-section-label mono">EXPERIENCE STRATEGY</h2>
          <div class="cs-strategy-statement" style={`--accent: ${project.accent}`}>
            <span class="mono">CORE PRODUCT PRINCIPLE</span>
            <h3>{project.strategy.title}</h3>
            <p>{project.strategy.desc}</p>
          </div>
          {project.architecture && (
            <div class="cs-architecture-grid">
              {project.architecture.map((item, i) => (
                <article class="cs-architecture-card"><span class="mono">LAYER {String(i + 1).padStart(2, '0')}</span><h3>{item.label}</h3><p>{item.desc}</p></article>
              ))}
            </div>
          )}
        </section>
      )}

      <!--  SOLUTION WALKTHROUGH  -->
      <section class="cs-section" id="cs-screens">
        <h2 class="cs-section-label mono">SOLUTION WALKTHROUGH</h2>
        {hasScreenImages && (
          <div class="cs-mobile-intro">
            <span class="mono">MOBILE APPLICATION / PORTRAIT UI</span>
            <p>Selected interface moments from the working {project.title} experience.</p>
          </div>
        )}
        {hasScreenImages && (
        <div class="cs-solution-grid cs-mobile-solution-grid">
          {screenImages.map(({ screen, image }, i) => (
              <article class="cs-mobile-screen" style={`--accent: ${project.accent}`}>
                <div class="cs-phone" aria-label={`${screen.title} mobile UI screenshot`}>
                  <div class="cs-phone-speaker" aria-hidden="true"></div>
                  <div class="cs-phone-viewport" style={project.slug === 'pregtrack-app' ? `aspect-ratio: ${image!.width} / ${image!.height}` : undefined}>
                    <Image src={image!} alt={`${project.title} ${screen.title} mobile application screen`} title={`${project.title} — ${screen.title}`} widths={[320, 480]} sizes="(max-width: 600px) 78vw, 300px" format="webp" quality={80} loading="lazy" decoding="async" />
                  </div>
                  <div class="cs-phone-home" aria-hidden="true"></div>
                </div>
                <div class="cs-mobile-caption">
                  <span class="cs-solution-index mono">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h3 class="cs-screen-title">{screen.title}</h3>
                    <p class="cs-screen-desc">{screen.desc}</p>
                  </div>
                </div>
              </article>
          ))}
        </div>
        )}
        {textOnlyScreens.length > 0 && (
        <div class="cs-solution-grid">
          {textOnlyScreens.map((screen, i) => (
              <article class="cs-solution-step" style={`--accent: ${project.accent}`}>
                <span class="cs-solution-index mono">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <span class="cs-solution-kicker mono">DESIGN MOMENT</span>
                  <h3 class="cs-screen-title">{screen.title}</h3>
                  <p class="cs-screen-desc">{screen.desc}</p>
                </div>
              </article>
          ))}
        </div>
        )}
      </section>

      <!--  DESIGN DECISIONS  -->
      <section class="cs-section" id="cs-decisions">
        <h2 class="cs-section-label mono">KEY DESIGN DECISIONS</h2>
        <div class="cs-decisions-list">
          {project.decisions.map((d, i) => (
            <div class="cs-decision-row" style={`--accent: ${project.accent}`}>
              <div class="cs-decision-left">
                <span class="cs-decision-num mono">{String(i + 1).padStart(2,'0')}</span>
                <span class="cs-decision-label">DECISION</span>
                <p class="cs-decision-text">{d.decision}</p>
              </div>
              <div class="cs-decision-arrow">-></div>
              <div class="cs-decision-right">
                <span class="cs-decision-label">RATIONALE</span>
                <p class="cs-decision-text">{d.rationale}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!--  OUTCOMES  -->
      <section class="cs-section" id="cs-outcomes">
        <h2 class="cs-section-label mono">OUTCOMES & IMPACT</h2>
        <div class="cs-outcomes-grid">
          {project.outcomes.map(o => (
            <div class="cs-outcome-card" style={`--accent: ${project.accent}`}>
              <span class="cs-outcome-metric">{o.metric}</span>
              <span class="cs-outcome-label mono">{o.label}</span>
            </div>
          ))}
        </div>
        {project.evidenceNote && (
          <div class="cs-evidence-note"><span class="mono">EVIDENCE BOUNDARY</span><p>{project.evidenceNote}</p></div>
        )}
      </section>

      {(project.validation || project.nextSteps) && (
        <section class="cs-section" id="cs-next">
          <h2 class="cs-section-label mono">VALIDATION & NEXT STEPS</h2>
          <div class="cs-next-grid">
            {project.validation && (
              <div class="cs-validation-panel"><span class="cs-next-kicker mono">WHAT I WOULD MEASURE OR TEST</span><ul>{project.validation.map(item => <li>{item}</li>)}</ul></div>
            )}
            {project.nextSteps && (
              <div class="cs-next-list">{project.nextSteps.map((item, i) => <article><span class="mono">PRIORITY {String(i + 1).padStart(2, '0')}</span><h3>{item.label}</h3><p>{item.desc}</p></article>)}</div>
            )}
          </div>
        </section>
      )}

      <!--  LEARNINGS  -->
      <section class="cs-section" id="cs-learnings">
        <h2 class="cs-section-label mono">LEARNINGS & REFLECTION</h2>
        <div class="cs-learnings-grid">
          <div class="cs-learning-col cs-learning-worked">
            <div class="cs-learning-header" style={`background: ${project.accent}`}>
              <span class="mono">* WHAT WORKED</span>
            </div>
            <ul class="cs-learning-list">
              {project.learnings.worked.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="cs-learning-col cs-learning-improve">
            <div class="cs-learning-header">
              <span class="mono">* WHAT I'D IMPROVE</span>
            </div>
            <ul class="cs-learning-list">
              {project.learnings.improve.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>

    </main>

    <!--  PROJECT NAVIGATION  -->
    <nav class="cs-project-nav" id="cs-project-nav">
      <div class="cs-container">
        <div class="cs-pnav-inner">
          {prevProject ? (
            <a href={projectUrl(prevProject.slug)} class="cs-pnav-card cs-pnav-prev">
              <span class="cs-pnav-dir mono">Previous work</span>
              <span class="cs-pnav-title">{prevProject.title}</span>
              <span class="cs-pnav-type mono">{prevProject.type}</span>
            </a>
          ) : <div />}

          <a href={pageUrl('/')} class="cs-pnav-all mono">HOME -></a>

          {nextProject ? (
            <a href={projectUrl(nextProject.slug)} class="cs-pnav-card cs-pnav-next">
              <span class="cs-pnav-dir mono">NEXT -></span>
              <span class="cs-pnav-title">{nextProject.title}</span>
              <span class="cs-pnav-type mono">{nextProject.type}</span>
            </a>
          ) : <div />}
        </div>
      </div>
    </nav>

  </div>
</Layout>

<style>
  /*  Base  */
  .case-study {
    background: var(--bg);
    min-height: 100dvh;
  }

  .cs-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .cs-body {
    padding-top: 0;
    padding-bottom: 80px;
  }

  .cs-section {
    padding: 64px 0;
    border-bottom: var(--border-thin);
  }

  .cs-section:last-child { border-bottom: none; }

  .cs-section-label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--grey);
    margin-bottom: 32px;
    padding: 6px 14px;
    border: var(--border-thick);
    background: var(--cream);
  }

  /*  Top Nav  */
  .cs-topnav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: var(--border-thick);
    padding: 14px 0;
    box-shadow: 0 4px 0 var(--primary);
  }

  .cs-topnav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cs-back {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--black);
    padding: 8px 16px;
    border: var(--border-thick);
    background: var(--primary);
    box-shadow: var(--shadow-sm);
    transition: all 0.15s ease;
  }

  .cs-back:hover {
    box-shadow: none;
    transform: none;
  }

  .cs-breadcrumb {
    font-size: var(--text-xs);
    color: var(--grey);
    letter-spacing: 1px;
  }

  .cs-breadcrumb a {
    color: var(--grey);
    transition: color 0.15s ease;
  }

  .cs-breadcrumb a:hover { color: var(--secondary); }

  /*  Hero  */
  .cs-hero {
    padding: 72px 0 48px;
    border-bottom: var(--border-brutal);
  }

  .cs-type-badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 6px 14px;
    background: var(--accent);
    border: var(--border-thick);
    box-shadow: var(--shadow-sm);
    margin-bottom: 24px;
    color: var(--black);
  }

  .cs-title {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 1.05;
    color: var(--black);
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .cs-tagline {
    font-size: var(--text-lg);
    color: var(--dark-grey);
    line-height: 1.6;
    max-width: 640px;
    margin-bottom: 40px;
  }

  .cs-meta-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border: var(--border-brutal);
    box-shadow: var(--shadow-sm);
    width: fit-content;
  }

  .cs-meta-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 24px;
    border-right: var(--border-thick);
    background: var(--white);
  }

  .cs-meta-item:last-child { border-right: none; }

  .cmi-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--grey);
    text-transform: uppercase;
  }

  .cmi-val {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--black);
  }

  /*  Cover Visual  */
  .cs-hero-visual {
    padding: 40px 0;
    background: var(--cream);
    border-bottom: var(--border-brutal);
  }

  .cs-cover-placeholder {
    border: var(--border-brutal);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    background: var(--white);
  }

  .cs-cover-browser {
    width: 100%;
  }

  .cs-cover-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--cream);
    border-bottom: var(--border-thick);
  }

  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.2);
    flex-shrink: 0;
  }

  .dot.red    { background: #ef4444; }
  .dot.yellow { background: #eab308; }
  .dot.green  { background: #22c55e; }

  .cs-cover-url {
    font-size: 11px;
    color: var(--grey);
    letter-spacing: 0.5px;
    margin-left: 8px;
  }

  .cs-cover-screen {
    height: 380px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: repeating-linear-gradient(
      45deg,
      var(--cream) 0px,
      var(--cream) 10px,
      var(--bg) 10px,
      var(--bg) 20px
    );
  }

  .cs-cover-label {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--grey);
    text-align: center;
    line-height: 2;
    padding: 24px 40px;
    background: var(--white);
    border: var(--border-brutal);
    box-shadow: var(--shadow-md);
  }

  .cs-cover-screen.has-banner {
    background: none;
    height: auto;
    min-height: 380px;
  }

  .cs-cover-banner-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #0b0d0f;
    display: block;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .cs-cover-placeholder:hover .cs-cover-banner-img {
    transform: scale(1.03);
  }

  /*  Overview  */
  .cs-overview-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr;
    gap: 48px;
    align-items: start;
  }

  .cs-overview-text {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--dark-grey);
  }

  .cs-stat-hero {
    border: var(--border-brutal);
    box-shadow: var(--shadow-primary);
    padding: 32px 24px;
    text-align: center;
    background: var(--white);
    margin-bottom: 16px;
    transition: all 0.15s ease;
  }

  .cs-stat-hero:hover {
    box-shadow: none;
    transform: none;
  }

  .cs-stat-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
    color: var(--primary);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .cs-stat-action > span:first-child {
    white-space: nowrap;
  }

  .cs-stat-action-arrow {
    flex: 0 0 auto;
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .cs-stat-action:hover,
  .cs-stat-action:focus-visible {
    color: var(--text);
    border-color: var(--primary);
  }

  .cs-stat-action:hover .cs-stat-action-arrow,
  .cs-stat-action:focus-visible .cs-stat-action-arrow {
    transform: translate(2px, -2px);
  }

  .cs-stat-action:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 6px;
  }

  .cs-stat-num {
    display: block;
    font-size: clamp(3rem, 6vw, 4.5rem);
    font-weight: 900;
    color: var(--black);
    line-height: 1;
    letter-spacing: -0.04em;
    margin-bottom: 8px;
  }

  .cs-stat-label {
    display: block;
    max-width: 100%;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--grey);
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .cs-team-card {
    border: var(--border-thick);
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--white);
  }

  .cs-team-val {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text);
  }

  /*  Challenge  */
  .cs-challenge-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  .cs-challenge-text {
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--dark-grey);
  }

  .cs-pain-list {
    border: var(--border-brutal);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .cs-pain-header {
    padding: 12px 20px;
    background: var(--black);
    color: var(--primary);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 2px;
    border-bottom: var(--border-thick);
  }

  .cs-pain-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 18px 20px;
    border-bottom: var(--border-thin);
    background: var(--white);
    transition: all 0.15s ease;
  }

  .cs-pain-item:last-child { border-bottom: none; }

  .cs-pain-item:hover {
    background: var(--cream);
    padding-left: 20px;
  }

  .cs-pain-num {
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--secondary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cs-pain-text {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text);
    line-height: 1.5;
  }

  /*  Research  */
  .cs-research-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border: var(--border-brutal);
    box-shadow: var(--shadow-sm);
    margin-bottom: 40px;
  }

  .cs-research-card {
    padding: 28px 20px;
    border-right: var(--border-thick);
    background: var(--white);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: all 0.15s ease;
  }

  .cs-research-card:last-child { border-right: none; }

  .cs-research-card:hover {
    background: var(--cream);
    transform: none;
    box-shadow: var(--shadow-sm);
  }

  .cs-research-num {
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .cs-research-label {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text);
    line-height: 1.2;
  }

  .cs-research-desc {
    font-size: 11px;
    font-weight: 500;
    color: var(--grey);
    letter-spacing: 0.3px;
    line-height: 1.5;
  }

  .cs-insights {
    border: var(--border-brutal);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .cs-insights-header {
    padding: 12px 20px;
    background: var(--secondary);
    color: var(--white);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 2px;
    border-bottom: var(--border-thick);
  }

  .cs-insight-row {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    padding: 20px 24px;
    border-bottom: var(--border-thin);
    background: var(--white);
    transition: all 0.15s ease;
  }

  .cs-insight-row:last-child { border-bottom: none; }

  .cs-insight-row:hover {
    background: var(--cream);
    padding-left: 24px;
  }

  .cs-insight-num {
    font-size: var(--text-xs);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 3px;
  }

  .cs-insight-text {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--text);
    line-height: 1.6;
  }

  /*  Process  */
  .cs-process-track {
    display: flex;
    align-items: stretch;
    gap: 0;
    border: var(--border-brutal);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .cs-process-step {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px 24px;
    border-right: var(--border-thick);
    background: var(--white);
    position: relative;
    transition: all 0.15s ease;
  }

  .cs-process-step:last-child { border-right: none; }

  .cs-process-step:hover {
    background: var(--accent, var(--primary));
  }

  .cs-ps-num {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--secondary);
  }

  .cs-ps-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text);
  }

  .cs-ps-desc {
    font-size: 11px;
    font-weight: 500;
    color: var(--grey);
    letter-spacing: 0.3px;
    line-height: 1.6;
  }

  .cs-ps-arrow {
    display: none;
  }

  /*  Screens  */
  .cs-screens-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .cs-screen-card {
    border: var(--border-brutal);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    background: var(--white);
    transition: all 0.15s ease;
  }

  .cs-screen-card:hover {
    box-shadow: none;
    transform: none;
  }

  .cs-screen-placeholder {
    border-bottom: var(--border-thick);
  }

  .cs-screen-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--cream);
    border-bottom: var(--border-thin);
  }

  .cs-screen-bar .dot {
    width: 8px;
    height: 8px;
  }

  .cs-screen-area {
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: repeating-linear-gradient(
      -45deg,
      var(--cream) 0px,
      var(--cream) 8px,
      var(--bg) 8px,
      var(--bg) 16px
    );
  }

  .cs-screen-area span {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--grey);
    padding: 10px 16px;
    background: var(--white);
    border: var(--border-thin);
  }

  .cs-screen-info {
    padding: 20px;
  }

  .cs-screen-title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 8px;
  }

  .cs-screen-desc {
    font-size: var(--text-sm);
    color: var(--grey);
    line-height: 1.6;
  }

  /*  Design Decisions  */
  .cs-decisions-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: var(--border-brutal);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .cs-decision-row {
    display: grid;
    grid-template-columns: 1fr 48px 1fr;
    border-bottom: var(--border-thick);
    background: var(--white);
    transition: background 0.15s ease;
  }

  .cs-decision-row:last-child { border-bottom: none; }

  .cs-decision-row:hover { background: var(--cream); }

  .cs-decision-left,
  .cs-decision-right {
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .cs-decision-left {
    border-right: var(--border-thin);
  }

  .cs-decision-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--secondary);
    border-right: var(--border-thin);
  }

  .cs-decision-num {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 2px;
  }

  .cs-decision-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--grey);
    text-transform: uppercase;
  }

  .cs-decision-text {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text);
    line-height: 1.6;
  }

  /*  Outcomes  */
  .cs-outcomes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: var(--border-brutal);
    box-shadow: var(--shadow-lg);
  }

  .cs-outcome-card {
    padding: 40px 24px;
    border-right: var(--border-thick);
    background: var(--white);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: all 0.15s ease;
  }

  .cs-outcome-card:last-child { border-right: none; }

  .cs-outcome-card:hover {
    background: var(--accent, var(--primary));
    transform: none;
    box-shadow: var(--shadow-sm);
  }

  .cs-outcome-metric {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 900;
    color: var(--black);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .cs-outcome-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--grey);
    text-transform: uppercase;
    line-height: 1.4;
  }

  /*  Learnings  */
  .cs-learnings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: var(--border-brutal);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .cs-learning-col {
    background: var(--white);
  }

  .cs-learning-col:first-child {
    border-right: var(--border-thick);
  }

  .cs-learning-header {
    padding: 14px 24px;
    background: var(--cream);
    border-bottom: var(--border-thick);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--black);
  }

  .cs-learning-worked .cs-learning-header {
    background: var(--accent, var(--primary));
  }

  .cs-learning-list {
    list-style: none;
    padding: 0;
  }

  .cs-learning-list li {
    padding: 18px 24px;
    border-bottom: var(--border-thin);
    font-size: var(--text-sm);
    color: var(--text);
    line-height: 1.6;
    padding-left: 40px;
    position: relative;
    transition: all 0.15s ease;
  }

  .cs-learning-list li:last-child { border-bottom: none; }

  .cs-learning-list li::before {
    content: '*';
    position: absolute;
    left: 20px;
    color: var(--secondary);
    font-size: 10px;
    top: 21px;
  }

  .cs-learning-list li:hover {
    background: var(--cream);
    padding-left: 40px;
  }

  /*  Project Navigation  */
  .cs-project-nav {
    border-top: var(--border-brutal);
    padding: 48px 0;
    background: var(--cream);
  }

  .cs-pnav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: center;
  }

  .cs-pnav-card {
    border: var(--border-brutal);
    box-shadow: var(--shadow-sm);
    padding: 24px;
    background: var(--white);
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: all 0.15s ease;
  }

  .cs-pnav-card:hover {
    box-shadow: none;
    transform: none;
    background: var(--primary);
  }

  .cs-pnav-next { text-align: right; }

  .cs-pnav-dir {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--grey);
    text-transform: uppercase;
  }

  .cs-pnav-title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text);
  }

  .cs-pnav-type {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    color: var(--grey);
  }

  .cs-pnav-all {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--black);
    padding: 14px 20px;
    border: var(--border-brutal);
    background: var(--primary);
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
    text-align: center;
    transition: all 0.15s ease;
  }

  .cs-pnav-all:hover {
    box-shadow: none;
    transform: none;
  }

  /*  Responsive  */
  @media (max-width: 1024px) {
    .cs-overview-grid    { grid-template-columns: 1fr; }
    .cs-challenge-grid   { grid-template-columns: 1fr; }
    .cs-research-grid    { grid-template-columns: repeat(2, 1fr); }
    .cs-research-card:nth-child(2) { border-right: none; }
    .cs-research-card:nth-child(1),
    .cs-research-card:nth-child(2) { border-bottom: var(--border-thick); }
    .cs-screens-grid     { grid-template-columns: 1fr 1fr; }
    .cs-process-track    { flex-direction: column; }
    .cs-process-step     { border-right: none; border-bottom: var(--border-thick); }
    .cs-process-step:last-child { border-bottom: none; }
    .cs-meta-strip       { flex-wrap: wrap; }
    .cs-meta-item        { border-bottom: var(--border-thin); }
  }

  @media (max-width: 768px) {
    .cs-title            { font-size: clamp(2rem, 8vw, 3rem); }
    .cs-screens-grid     { grid-template-columns: 1fr; }
    .cs-outcomes-grid    { grid-template-columns: 1fr; }
    .cs-outcome-card     { border-right: none; border-bottom: var(--border-thick); }
    .cs-outcome-card:last-child { border-bottom: none; }
    .cs-learnings-grid   { grid-template-columns: 1fr; }
    .cs-learning-col:first-child { border-right: none; border-bottom: var(--border-thick); }
    .cs-decision-row     { grid-template-columns: 1fr; }
    .cs-decision-left    { border-right: none; border-bottom: var(--border-thin); }
    .cs-decision-arrow   { display: none; }
    .cs-pnav-inner       { grid-template-columns: 1fr; }
    .cs-pnav-all         { order: -1; }
    .cs-breadcrumb       { display: none; }
  }
  .cs-skip { position: fixed; left: 20px; top: -80px; z-index: 200; padding: 12px 16px; background: var(--primary); color: var(--black); font-family: var(--font-mono); font-size: 12px; font-weight: 700; border: var(--border-thick); }
  .cs-skip:focus { top: 16px; }
  .cs-executive-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: min(100%, 860px); border: var(--border-brutal); margin-top: 24px; }
  .cs-executive-summary > div { display: grid; gap: 7px; padding: 16px 18px; background: var(--white); border-right: var(--border-thick); }
  .cs-executive-summary > div:last-child { border-right: 0; }
  .cs-executive-summary span { font-size: 10px; font-weight: 700; letter-spacing: 1.5px; color: var(--grey); }
  .cs-executive-summary strong { font-size: var(--text-sm); line-height: 1.35; color: var(--text); }
  .cs-case-toc { position: sticky; top: 61px; z-index: 90; background: color-mix(in srgb, var(--bg) 94%, transparent); backdrop-filter: blur(10px); border-bottom: var(--border-thin); }
  .cs-case-toc .cs-container { display: flex; gap: 4px; overflow-x: auto; scrollbar-width: thin; }
  .cs-case-toc a { flex: 0 0 auto; padding: 13px 11px; font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--grey); }
  .cs-case-toc a:hover, .cs-case-toc a:focus-visible { color: var(--text); background: var(--primary); outline: none; }
  .cs-solution-grid { display: grid; grid-template-columns: repeat(3, 1fr); border: var(--border-brutal); }
  .cs-solution-step { display: grid; grid-template-columns: auto 1fr; gap: 18px; padding: 28px 22px; background: var(--white); border-right: var(--border-thick); min-height: 210px; }
  .cs-solution-step:last-child { border-right: 0; }
  .cs-solution-step:hover { background: var(--cream); }
  .cs-solution-index { color: var(--secondary); font-size: var(--text-xs); font-weight: 700; }
  .cs-solution-kicker { display: block; color: var(--grey); font-size: 10px; font-weight: 700; letter-spacing: 1.5px; margin-bottom: 14px; }
  .cs-mobile-intro { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin: -8px 0 36px; padding-bottom: 18px; border-bottom: var(--border-thin); }
  .cs-mobile-intro span { color: var(--primary); font-size: 10px; font-weight: 700; letter-spacing: 1.5px; }
  .cs-mobile-intro p { max-width: 48ch; color: var(--grey); font-size: var(--text-sm); line-height: 1.55; text-align: right; }
  .cs-mobile-solution-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(28px, 5vw, 64px) clamp(20px, 4vw, 48px); border: 0; overflow: visible; }
